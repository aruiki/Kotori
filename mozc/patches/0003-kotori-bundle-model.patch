diff --git a/src/data/kotori/BUILD.bazel b/src/data/kotori/BUILD.bazel
new file mode 100644
index 000000000..60a35d9f6
--- /dev/null
+++ b/src/data/kotori/BUILD.bazel
@@ -0,0 +1,13 @@
+# Kotori: MSI に同梱する物(docs/adr/0016、0017)。モデル(*.gguf)はコミットしないので、ビルドの前に
+# ここに置く(mozc/README.md)。
+package(default_visibility = ["//visibility:public"])
+
+exports_files([
+    "zenz-v2.5-small-q8_0.gguf",
+    "tinyswallow-1.5b-q5_k_m.gguf",
+    "NOTICE-zenz.txt",
+    "NOTICE-tinyswallow.txt",
+    "license.rtf",
+    "banner.bmp",
+    "dialog.bmp",
+])
diff --git a/src/data/kotori/NOTICE-tinyswallow.txt b/src/data/kotori/NOTICE-tinyswallow.txt
new file mode 100644
index 000000000..d80696564
--- /dev/null
+++ b/src/data/kotori/NOTICE-tinyswallow.txt
@@ -0,0 +1,11 @@
+Kotori IME に同梱している言語モデル(LLM)
+
+TinySwallow-1.5B (c) Sakana AI
+  https://huggingface.co/SakanaAI/TinySwallow-1.5B
+  ライセンス: Apache License 2.0 https://www.apache.org/licenses/LICENSE-2.0
+
+変更点: 公開されている重みを llama.cpp で GGUF(f16)にし、Q5_K_M に量子化した。
+学習した内容は変えていない。
+
+llama.cpp / ggml (MIT): https://github.com/ggml-org/llama.cpp
+  インストール先の LICENSE-llama.cpp.txt を参照。
