@@ -0,0 +1,571 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/lm_rewriter.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <numeric>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/container/flat_hash_map.h"
+#include "absl/synchronization/mutex.h"
+#include "base/file_util.h"
+#include "base/system_util.h"
+#include "base/util.h"
+#include "converter/candidate.h"
+#include "converter/segments.h"
+#include "dictionary/dictionary_interface.h"
+#include "dictionary/dictionary_token.h"
+#include "dictionary/single_kanji_dictionary.h"
+#include "protocol/config.pb.h"
+#include "request/conversion_request.h"
+#include "rewriter/llama_runtime.h"
+
+namespace mozc {
+namespace {
+
+constexpr char kDefaultModelName[] = "zenz-v2.5-small-q8_0.gguf";
+// 汎用の LLM(TinySwallow-1.5B、Apache-2.0)。GPU 向け(docs/adr/0016)。
+constexpr char kLlmModelName[] = "tinyswallow-1.5b-q5_k_m.gguf";
+constexpr size_t kMaxContextBytes = 240;  // 40 文字ぶん以上
+
+struct Quality {
+  size_t k;
+  const char* model;
+};
+
+Quality QualityOf(config::Config::KotoriLmQuality q) {
+  switch (q) {
+    case config::Config::KOTORI_LM_LOW:
+      return {4, "zenz-v2.5-xsmall-q8_0.gguf"};
+    case config::Config::KOTORI_LM_HIGH:
+      return {16, kDefaultModelName};
+    case config::Config::KOTORI_LM_UNREAL:
+      return {16, "zenz-v2.5-medium-q8_0.gguf"};
+    default:
+      return {8, kDefaultModelName};
+  }
+}
+
+const char* Env(const char* name) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? v : nullptr;
+}
+
+std::string Tail(const std::string& s) {
+  return s.size() > kMaxContextBytes ? s.substr(s.size() - kMaxContextBytes)
+                                     : s;
+}
+
+std::string ConversionReading(const Segments& segments);
+
+// UTF-8 の文字列を 1 文字ずつに分ける。
+std::vector<std::string> Chars(absl::string_view s) {
+  std::vector<std::string> out;
+  for (size_t i = 0; i < s.size();) {
+    const unsigned char c = s[i];
+    size_t n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+    n = std::min(n, s.size() - i);
+    out.emplace_back(s.substr(i, n));
+    i += n;
+  }
+  return out;
+}
+
+// カタカナ 1 文字をひらがなにする(それ以外はそのまま)。
+std::string ToHiragana(const std::string& c) {
+  if (c.size() == 3 && static_cast<unsigned char>(c[0]) == 0xE3) {
+    const uint32_t cp =
+        ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+    if (cp >= 0x30A1 && cp <= 0x30F6) {
+      const uint32_t h = cp - 0x60;
+      std::string out;
+      out += static_cast<char>(0xE0 | (h >> 12));
+      out += static_cast<char>(0x80 | ((h >> 6) & 0x3F));
+      out += static_cast<char>(0x80 | (h & 0x3F));
+      return out;
+    }
+  }
+  return c;
+}
+
+// 先頭の 1 文字の濁点・半濁点を外す(「が」→「か」、「ぱ」→「は」)。
+std::string Unvoice(const std::string& key) {
+  if (key.size() < 3 || static_cast<unsigned char>(key[0]) != 0xE3) return key;
+  const uint32_t cp =
+      ((key[0] & 0x0F) << 12) | ((key[1] & 0x3F) << 6) | (key[2] & 0x3F);
+  uint32_t base = cp;
+  if ((cp >= 0x304C && cp <= 0x3062 && cp % 2 == 0) ||   // が〜ぢ
+      (cp >= 0x3065 && cp <= 0x3069 && cp % 2 == 1)) {   // づ〜ど
+    base = cp - 1;
+  } else if (cp >= 0x3070 && cp <= 0x307D) {             // ば〜ぽ
+    const uint32_t m = (cp - 0x306F) % 3;                // 1: 濁音、2: 半濁音
+    if (m != 0) base = cp - m;
+  }
+  if (base == cp) return key;
+  std::string out;
+  out += static_cast<char>(0xE0 | (base >> 12));
+  out += static_cast<char>(0x80 | ((base >> 6) & 0x3F));
+  out += static_cast<char>(0x80 | (base & 0x3F));
+  return out + key.substr(3);
+}
+
+// 数字・英字(半角と全角)。読みを数文字ずつ消費してよい文字として扱う。
+bool IsAlnum(const std::string& c) {
+  if (c.size() == 1) return std::isalnum(static_cast<unsigned char>(c[0]));
+  if (c.size() == 3 && static_cast<unsigned char>(c[0]) == 0xEF) {
+    const uint32_t cp =
+        ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+    return (cp >= 0xFF10 && cp <= 0xFF19) || (cp >= 0xFF21 && cp <= 0xFF3A) ||
+           (cp >= 0xFF41 && cp <= 0xFF5A);
+  }
+  return false;
+}
+
+class PrefixCollector : public dictionary::DictionaryInterface::Callback {
+ public:
+  ResultType OnToken(absl::string_view, absl::string_view,
+                     dictionary::Token token) override {
+    found.emplace_back(std::move(token.key), std::move(token.value));
+    return TRAVERSE_CONTINUE;
+  }
+  std::vector<std::pair<std::string, std::string>> found;  // (読み, 表記)
+};
+
+// 生成した文 text が読み reading に過不足なく合うか、辞書で確かめる。読みの先頭から、
+// 辞書の語(読みが前方一致し、表記が text の続きに合うもの)、同じかな・記号、数字と英字
+// (1 文字で読み 1〜6 文字)をたどり、両方の終わりに着けば合う。
+bool MatchesReading(const dictionary::DictionaryInterface& dic,
+                    const dictionary::SingleKanjiDictionary* single_kanji,
+                    absl::string_view text, absl::string_view reading) {
+  const std::vector<std::string> t = Chars(text);
+  const std::vector<std::string> r = Chars(reading);
+  std::vector<size_t> r_off(r.size() + 1, 0);
+  for (size_t j = 0; j < r.size(); ++j) r_off[j + 1] = r_off[j] + r[j].size();
+  std::vector<std::string> t_prefix(t.size() + 1);  // t_prefix[i] = t[i..] の UTF-8
+  for (size_t i = t.size(); i-- > 0;) t_prefix[i] = t[i] + t_prefix[i + 1];
+  std::vector<std::vector<bool>> seen(t.size() + 1,
+                                      std::vector<bool>(r.size() + 1, false));
+  std::vector<std::optional<PrefixCollector>> lookups(r.size());
+  absl::flat_hash_map<std::string, std::vector<std::string>> kanji_cache;
+  std::vector<std::pair<size_t, size_t>> stack = {{0, 0}};
+  seen[0][0] = true;
+  auto push = [&](size_t i, size_t j) {
+    if (i <= t.size() && j <= r.size() && !seen[i][j]) {
+      seen[i][j] = true;
+      stack.emplace_back(i, j);
+    }
+  };
+  while (!stack.empty()) {
+    const auto [i, j] = stack.back();
+    stack.pop_back();
+    if (i == t.size() && j == r.size()) return true;
+    if (i < t.size() && j < r.size() && ToHiragana(t[i]) == r[j]) {
+      push(i + 1, j + 1);
+    }
+    if (i < t.size() && IsAlnum(t[i])) {
+      for (size_t k = 1; k <= 6; ++k) push(i + 1, j + k);
+    }
+    // 辞書にない語(「夜駆け」など)は、漢字 1 文字ずつの読み(単漢字辞書)で確かめる。
+    if (single_kanji != nullptr && i < t.size() && t[i].size() >= 3) {
+      for (size_t k = 1; k <= 4 && j + k <= r.size(); ++k) {
+        const std::string key = std::string(
+            reading.substr(r_off[j], r_off[j + k] - r_off[j]));
+        // 連濁(「よがけ」の「が」→「駆(か)」)も認める。
+        for (const std::string& variant : {key, Unvoice(key)}) {
+          auto it = kanji_cache.find(variant);
+          if (it == kanji_cache.end()) {
+            it = kanji_cache
+                     .emplace(variant,
+                              single_kanji->LookupKanjiEntries(variant, false))
+                     .first;
+          }
+          if (std::find(it->second.begin(), it->second.end(), t[i]) !=
+              it->second.end()) {
+            push(i + 1, j + k);
+          }
+        }
+      }
+    }
+    if (i < t.size() && j < r.size()) {
+      if (!lookups[j]) {
+        lookups[j].emplace();
+        dic.LookupPrefix(reading.substr(r_off[j]), &*lookups[j]);
+      }
+      for (const auto& [key, value] : lookups[j]->found) {
+        if (value.empty() || key.empty()) continue;
+        if (absl::string_view(t_prefix[i]).substr(0, value.size()) != value) {
+          continue;
+        }
+        push(i + Chars(value).size(), j + Chars(key).size());
+      }
+    }
+  }
+  return false;
+}
+
+// 評価用: KOTORI_LM_CONTEXT_MAP に「読み<TAB>前の文」の行を書いたファイル(UTF-8)を渡すと、
+// 変換中の読みに合う前の文を左の文脈にする(1 回の起動で多くの問題を解くため)。
+const absl::flat_hash_map<std::string, std::string>& ContextMap() {
+  static const auto* map = [] {
+    auto* m = new absl::flat_hash_map<std::string, std::string>();
+    if (const char* path = Env("KOTORI_LM_CONTEXT_MAP")) {
+      std::ifstream in(path, std::ios::binary);
+      std::string line;
+      while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        const size_t tab = line.find('\t');
+        if (tab != std::string::npos) {
+          (*m)[line.substr(0, tab)] = line.substr(tab + 1);
+        }
+      }
+    }
+    return m;
+  }();
+  return *map;
+}
+
+// 左の文脈。アプリが渡す直前の文(TSF の preceding_text)があればそれを使い、
+// なければ確定済みの文節(履歴)の値をつなぐ。KOTORI_LM_PRECEDING は評価用。
+std::string HistoryContext(const ConversionRequest& request,
+                           const Segments& segments) {
+  if (const char* v = Env("KOTORI_LM_PRECEDING")) return Tail(v);
+  if (!ContextMap().empty()) {
+    const auto it = ContextMap().find(ConversionReading(segments));
+    return it == ContextMap().end() ? std::string() : Tail(it->second);
+  }
+  std::string preceding = request.GetSurroundingContext().first;
+  if (!preceding.empty()) return Tail(preceding);
+  std::string context;
+  for (const Segment& seg : segments.history_segments()) {
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return Tail(context);
+}
+
+std::string ConversionReading(const Segments& segments) {
+  std::string reading;
+  for (const Segment& seg : segments.conversion_segments()) {
+    reading += seg.key();
+  }
+  return reading;
+}
+
+}  // namespace
+
+LmRewriter::LmRewriter(const dictionary::DictionaryInterface* dictionary,
+                       const dictionary::SingleKanjiDictionary* single_kanji)
+    : dictionary_(dictionary), single_kanji_(single_kanji) {
+  if (const char* v = Env("KOTORI_LM_K")) {
+    k_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_SENTENCE")) sentence_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_POST")) post_segment_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_RIGHT")) right_context_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_THREADS")) {
+    threads_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_WEIGHTS")) {
+    double a, b, t;
+    if (std::sscanf(v, "%lf,%lf,%lf", &a, &b, &t) == 3 && t > 0) {
+      lambda_lm_ = a;
+      lambda_lattice_ = b;
+      temperature_ = t;
+    }
+  }
+  if (const char* v = Env("KOTORI_ZENZ_MODEL")) env_model_path_ = v;
+  if (const char* v = Env("KOTORI_LLM_MODEL")) env_llm_path_ = v;
+  if (const char* v = Env("KOTORI_LM_BEAMS")) beams_override_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_NSENT")) {
+    max_sentences_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_WEIGHT")) lambda_llm_ = std::atof(v);
+  model_dir_ = SystemUtil::GetServerDirectory();
+  // llama.cpp の DLL とモデルのフォルダ(評価用に差し替えられる)。
+  runtime_dir_ = model_dir_;
+  if (const char* v = Env("KOTORI_RUNTIME_DIR")) runtime_dir_ = v;
+  if (const char* v = Env("KOTORI_MODEL_DIR")) model_dir_ = v;
+}
+
+void LmRewriter::EnsureLoaded(const std::string& path) const {
+  if (loaded_ && loaded_path_ == path) return;
+  loaded_ = true;
+  loaded_path_ = path;
+  scorer_.reset();
+  if (!FileUtil::FileExists(path).ok()) return;
+  scorer_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+void LmRewriter::EnsureLlmLoaded(const std::string& path) const {
+  if (llm_loaded_ && llm_path_ == path) return;
+  llm_loaded_ = true;
+  llm_path_ = path;
+  llm_.reset();
+  if (path.empty() || !FileUtil::FileExists(path).ok()) return;
+  llm_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+ZenzScorer* LmRewriter::Prepare(const ConversionRequest& request, size_t* k,
+                                ZenzScorer** llm, int* beams) const {
+  *llm = nullptr;
+  const config::Config& config = request.config();
+  if (!config.kotori_lm_enabled()) return nullptr;
+  const Quality quality = QualityOf(config.kotori_lm_quality());
+  *k = k_override_.value_or(quality.k);
+  *beams = beams_override_.value_or(
+      config.kotori_lm_quality() == config::Config::KOTORI_LM_LOW ? 2 : 8);
+  if (*k < 2) return nullptr;
+  // zenz(生成と採点。常に使う): KOTORI_ZENZ_MODEL → 品質の段階の zenz → 同梱の zenz。
+  std::string path = env_model_path_;
+  if (path.empty()) {
+    path = FileUtil::JoinPath(model_dir_, quality.model);
+    if (!FileUtil::FileExists(path).ok()) {
+      path = FileUtil::JoinPath(model_dir_, kDefaultModelName);
+    }
+  }
+  EnsureLoaded(path);
+  // LLM(文全体の採点に加える): AI モデルが LLM か、自動で GPU があるとき(docs/adr/0016)。
+  // ファイルは設定のパス → KOTORI_LLM_MODEL → 同梱の LLM。
+  const config::Config::KotoriLmModel kind = config.kotori_lm_model();
+  const bool want_llm =
+      kind == config::Config::KOTORI_LM_MODEL_LLM ||
+      (kind == config::Config::KOTORI_LM_MODEL_AUTO &&
+       EnsureLlamaRuntime(runtime_dir_) && LlamaHasGpu());
+  std::string llm_path;
+  if (want_llm) {
+    llm_path = config.kotori_lm_model_path();
+    if (llm_path.empty()) llm_path = env_llm_path_;
+    if (llm_path.empty()) llm_path = FileUtil::JoinPath(model_dir_, kLlmModelName);
+  }
+  EnsureLlmLoaded(llm_path);
+  *llm = llm_.get();
+  return scorer_.get();
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::CheckResizeSegmentsRequest(const ConversionRequest& request,
+                                       const Segments& segments) const {
+  if (!sentence_) return std::nullopt;
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] sentences=%zu segments=%zu\n",
+                 sentences.size(), segments.conversion_segments_size());
+  }
+  // 文全体の候補は、区切りが決まっていない最初の変換のときだけある(切り直した後の変換では空)。
+  if (sentences.empty()) return std::nullopt;
+  absl::MutexLock lock(mutex_);
+  best_.reset();
+  size_t k = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = Prepare(request, &k, &llm, &beams);
+  if (scorer == nullptr) return std::nullopt;
+
+  const std::string reading = ConversionReading(segments);
+  const std::string context = HistoryContext(request, segments);
+  // 候補 = ラティスの文全体の候補(区切り付き)+ zenz が読みから生成した文(区切りなし)。
+  std::vector<const converter::Candidate*> cands;
+  std::vector<std::string> values;
+  for (const converter::Candidate& c : sentences) {
+    if (c.key != reading || c.inner_segment_boundary.empty()) continue;
+    if (std::find(values.begin(), values.end(), c.value) != values.end()) {
+      continue;
+    }
+    cands.push_back(&c);
+    values.push_back(c.value);
+    if (cands.size() >= max_sentences_) break;
+  }
+  if (beams > 0 && Util::CharsLen(reading) <= 255) {
+    for (const std::string& g : scorer->Generate(context, reading, beams)) {
+      if (std::find(values.begin(), values.end(), g) != values.end()) continue;
+      // 読みを落とした文や、読みにない語を足した文を除く。
+      if (dictionary_ != nullptr &&
+          !MatchesReading(*dictionary_, single_kanji_, g, reading)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected %s\n", g.c_str());
+        }
+        continue;
+      }
+      cands.push_back(nullptr);
+      values.push_back(g);
+    }
+  }
+  if (values.size() < 2) return std::nullopt;
+  // 点数 = zenz の log P(文 | 読み、前の文) + LLM の log P(文 | 前の文)(docs/adr/0016)。
+  // LLM がないときは zenz だけで選ぶ。
+  const std::optional<std::vector<float>> zlogp =
+      scorer->Score(context, reading, values);
+  if (!zlogp) return std::nullopt;
+  std::optional<std::vector<float>> llogp;
+  if (llm != nullptr) llogp = llm->Score(context, reading, values);
+  size_t top = 0;
+  double top_score = 0;
+  const bool debug = Env("KOTORI_LM_DEBUG") != nullptr;
+  for (size_t i = 0; i < values.size(); ++i) {
+    double s = lambda_lm_ * (*zlogp)[i];
+    if (llogp) s += lambda_llm_ * (*llogp)[i];
+    if (debug) {
+      std::fprintf(stderr, "[kotori] %s zenz=%.2f llm=%.2f %s score=%.2f\n",
+                   values[i].c_str(), (*zlogp)[i], llogp ? (*llogp)[i] : 0.f,
+                   cands[i] == nullptr ? "gen" : "lattice", s);
+    }
+    if (i == 0 || s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+
+  Best best{reading, context, {}, {}};
+  if (cands[top] == nullptr) {
+    // 生成した文は区切りを持たないので、全体を 1 つの文節にする。
+    best.keys.push_back(reading);
+    best.values.push_back(values[top]);
+  } else {
+    for (const auto& inner : cands[top]->inner_segments()) {
+      best.keys.emplace_back(inner.GetKey());
+      best.values.emplace_back(inner.GetValue());
+    }
+  }
+  if (best.keys.empty()) return std::nullopt;
+
+  // 今の区切りと同じなら、切り直さずに Rewrite で先頭を入れ替える。
+  std::vector<std::string> current;
+  for (const Segment& seg : segments.conversion_segments()) {
+    current.emplace_back(seg.key());
+  }
+  best_ = best;
+  if (current == best.keys) return std::nullopt;
+
+  ResizeSegmentsRequest resize;
+  resize.segment_index = 0;
+  const size_t n = std::min(best.keys.size(), resize.segment_sizes.size());
+  for (size_t i = 0; i < n; ++i) {
+    const size_t len = Util::CharsLen(best.keys[i]);
+    if (len == 0 || len > 255) {
+      best_.reset();
+      return std::nullopt;
+    }
+    resize.segment_sizes[i] = static_cast<uint8_t>(len);
+  }
+  return resize;
+}
+
+bool LmRewriter::ApplyBest(Segments* segments,
+                           const std::string& context) const {
+  if (!best_ || best_->context != context ||
+      best_->reading != ConversionReading(*segments)) {
+    return false;
+  }
+  size_t i = 0;
+  for (const Segment& seg : segments->conversion_segments()) {
+    if (i >= best_->keys.size() || seg.key() != best_->keys[i]) return false;
+    ++i;
+  }
+  if (i != best_->keys.size()) return false;
+
+  bool changed = false;
+  i = 0;
+  for (Segment& seg : segments->conversion_segments()) {
+    const std::string& value = best_->values[i++];
+    if (seg.candidates_size() == 0 || seg.candidate(0).value == value) {
+      continue;
+    }
+    int found = -1;
+    for (size_t j = 1; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == value) {
+        found = static_cast<int>(j);
+        break;
+      }
+    }
+    converter::Candidate c = seg.candidate(found >= 0 ? found : 0);
+    if (found >= 0) {
+      seg.erase_candidate(found);
+    } else {
+      // 文節の候補にない値(文全体の候補でだけ出たもの)は、先頭の候補を写して作る。
+      c.value = value;
+      c.content_value = value;
+      c.content_key = std::string(seg.key());
+      c.inner_segment_boundary.clear();
+    }
+    *seg.insert_candidate(0) = std::move(c);
+    changed = true;
+  }
+  return changed;
+}
+
+bool LmRewriter::RewriteEachSegment(const ConversionRequest& request,
+                                    ZenzScorer* scorer, size_t k,
+                                    Segments* segments) const {
+  std::string context = HistoryContext(request, *segments);
+  bool changed = false;
+  const size_t num_segments = segments->conversion_segments_size();
+  for (size_t s = 0; s < num_segments; ++s) {
+    Segment& seg = *segments->mutable_conversion_segment(s);
+    const size_t n = std::min(seg.candidates_size(), k);
+    if (n >= 2 && !seg.key().empty()) {
+      // 読みと候補の後ろに、残りの文節の読みと第 1 候補をつなぐ。「はが」だけでは
+      // 葉/歯を決められないが、「はがいたい」なら決められる。
+      std::string reading(seg.key());
+      std::string suffix;
+      if (right_context_) {
+        for (size_t t = s + 1; t < num_segments; ++t) {
+          const Segment& next = segments->conversion_segment(t);
+          if (next.candidates_size() == 0) break;
+          reading += next.key();
+          suffix += next.candidate(0).value;
+        }
+      }
+      std::vector<std::string> values;
+      values.reserve(n);
+      for (size_t i = 0; i < n; ++i) {
+        values.push_back(seg.candidate(i).value + suffix);
+      }
+      if (auto logp = scorer->Score(Tail(context), reading, values)) {
+        std::vector<double> score(n);
+        for (size_t i = 0; i < n; ++i) {
+          score[i] = Combine((*logp)[i], seg.candidate(i).cost);
+        }
+        std::vector<size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+          return score[a] > score[b];
+        });
+        std::vector<converter::Candidate> copies;
+        copies.reserve(n);
+        for (size_t i = 0; i < n; ++i) copies.push_back(seg.candidate(order[i]));
+        for (size_t i = 0; i < n; ++i) {
+          *seg.mutable_candidate(i) = std::move(copies[i]);
+        }
+        changed = changed || order[0] != 0;
+      }
+    }
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return changed;
+}
+
+bool LmRewriter::Rewrite(const ConversionRequest& request,
+                         Segments* segments) const {
+  absl::MutexLock lock(mutex_);
+  size_t k = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = Prepare(request, &k, &llm, &beams);
+  if (scorer == nullptr) return false;
+  // 文全体で選んだ文が今の区切りに合えば、それを先頭に置く。
+  const bool applied =
+      sentence_ && ApplyBest(segments, HistoryContext(request, *segments));
+  if (applied && !post_segment_) return true;
+  // 文節ごとにも見直す(数字の書き方など、文全体の候補にない変種を比べる)。
+  return RewriteEachSegment(request, scorer, k, segments) || applied;
+}
