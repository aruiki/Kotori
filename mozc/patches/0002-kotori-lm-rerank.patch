+//
+// Kotori: AI による変換(docs/adr/0013、0015、0016)。
+
+#ifndef MOZC_REWRITER_LM_REWRITER_H_
+#define MOZC_REWRITER_LM_REWRITER_H_
+
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "absl/base/thread_annotations.h"
