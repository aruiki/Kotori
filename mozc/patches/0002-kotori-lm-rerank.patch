+
+LmRewriter::LmRewriter(const dictionary::DictionaryInterface* dictionary,
+                       const dictionary::SingleKanjiDictionary* single_kanji)
+    : dictionary_(dictionary), single_kanji_(single_kanji) {
+  if (const char* v = Env("KOTORI_LM_K")) {
+    k_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_SENTENCE")) sentence_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_POST")) post_segment_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_RIGHT")) right_context_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_THREADS")) {
+    threads_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_WEIGHTS")) {
+    double a, b, t;
+    if (std::sscanf(v, "%lf,%lf,%lf", &a, &b, &t) == 3 && t > 0) {
+      lambda_lm_ = a;
+      lambda_lattice_ = b;
+      temperature_ = t;
+    }
+  }
+  if (const char* v = Env("KOTORI_ZENZ_MODEL")) env_model_path_ = v;
+  if (const char* v = Env("KOTORI_LLM_MODEL")) env_llm_path_ = v;
+  if (const char* v = Env("KOTORI_LM_BEAMS")) beams_override_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT")) predict_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_PREDICT_MODE")) predict_mode_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT_TOKENS")) {
+    predict_tokens_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_PREDICT_BEAMS")) {
+    predict_beams_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_TOP")) {
+    llm_top_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_NSENT")) {
+    max_sentences_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_WEIGHT")) lambda_llm_ = std::atof(v);
+  model_dir_ = SystemUtil::GetServerDirectory();
+  // llama.cpp の DLL とモデルのフォルダ(評価用に差し替えられる)。
+  runtime_dir_ = model_dir_;
+  if (const char* v = Env("KOTORI_RUNTIME_DIR")) runtime_dir_ = v;
+  if (const char* v = Env("KOTORI_MODEL_DIR")) model_dir_ = v;
+  // 今の設定のモデルを裏で読み込んでおく(最初の変換で 1 秒以上待たないため)。
+  const char* preload = Env("KOTORI_LM_PRELOAD");
+  if (preload == nullptr || *preload != '0') {
+    preload_ = std::thread([this] {
+      const config::Config config = config::ConfigHandler::GetCopiedConfig();
+      absl::MutexLock lock(mutex_);
+      size_t k = 0, llm_top = 0;
+      int beams = 0;
+      ZenzScorer* llm = nullptr;
+      PrepareFor(config, &k, &llm, &beams, &llm_top);
+    });
+  }
+}
+
+LmRewriter::~LmRewriter() {
+  if (preload_.joinable()) preload_.join();
+}
+
+void LmRewriter::EnsureLoaded(const std::string& path) const {
+  if (loaded_ && loaded_path_ == path) return;
+  loaded_ = true;
+  loaded_path_ = path;
+  scorer_.reset();
+  if (!FileUtil::FileExists(path).ok()) return;
+  scorer_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+void LmRewriter::EnsureLlmLoaded(const std::string& path) const {
+  if (llm_loaded_ && llm_path_ == path) return;
+  llm_loaded_ = true;
+  llm_path_ = path;
+  llm_.reset();
+  if (path.empty() || !FileUtil::FileExists(path).ok()) return;
+  llm_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+ZenzScorer* LmRewriter::Prepare(const ConversionRequest& request, size_t* k,
+                                ZenzScorer** llm, int* beams) const {
+  size_t llm_top = 0;
+  return PrepareFor(request.config(), k, llm, beams, &llm_top);
+}
+
+ZenzScorer* LmRewriter::PrepareFor(const config::Config& config, size_t* k,
+                                   ZenzScorer** llm, int* beams,
+                                   size_t* llm_top) const {
+  *llm = nullptr;
+  if (!config.kotori_lm_enabled()) return nullptr;
+  const Quality quality = QualityOf(config.kotori_lm_quality());
+  *k = k_override_.value_or(quality.k);
+  *beams = beams_override_.value_or(quality.beams);
+  *llm_top = llm_top_override_.value_or(quality.llm_top);
+  if (*k < 2) return nullptr;
+  // zenz(生成と採点。常に使う): KOTORI_ZENZ_MODEL → 品質の段階の zenz → 同梱の zenz。
+  std::string path = env_model_path_;
+  if (path.empty()) {
+    path = FileUtil::JoinPath(model_dir_, quality.model);
+    if (!FileUtil::FileExists(path).ok()) {
+      path = FileUtil::JoinPath(model_dir_, kDefaultModelName);
+    }
+  }
+  EnsureLoaded(path);
+  // LLM(文全体の採点に加える): AI モデルが LLM か、自動で GPU があるとき(docs/adr/0016)。
+  // ファイルは設定のパス → KOTORI_LLM_MODEL → 同梱の LLM。
+  // 品質が Low(llm_top が 0)なら LLM を使わない(VRAM も空ける)。
+  const config::Config::KotoriLmModel kind = config.kotori_lm_model();
+  const bool want_llm =
+      *llm_top > 0 &&
+      (kind == config::Config::KOTORI_LM_MODEL_LLM ||
+       (kind == config::Config::KOTORI_LM_MODEL_AUTO &&
+        EnsureLlamaRuntime(runtime_dir_) && LlamaHasGpu()));
+  std::string llm_path;
+  if (want_llm) {
+    llm_path = config.kotori_lm_model_path();
+    if (llm_path.empty()) llm_path = env_llm_path_;
+    if (llm_path.empty()) llm_path = FileUtil::JoinPath(model_dir_, kLlmModelName);
+  }
+  EnsureLlmLoaded(llm_path);
+  *llm = llm_.get();
+  return scorer_.get();
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::CheckResizeSegmentsRequest(const ConversionRequest& request,
+                                       const Segments& segments) const {
+  if (!sentence_ || request.request_type() != ConversionRequest::CONVERSION) {
+    return std::nullopt;
+  }
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] sentences=%zu segments=%zu\n",
+                 sentences.size(), segments.conversion_segments_size());
+  }
+  // 文全体の候補は、区切りが決まっていない最初の変換のときだけある(切り直した後の変換では空)。
+  if (sentences.empty()) return std::nullopt;
+  absl::MutexLock lock(mutex_);
+  best_.reset();
+  const auto t0 = std::chrono::steady_clock::now();
+  auto ms = [](auto a, auto b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+  };
+  size_t k = 0;
+  int beams = 0;
+  size_t llm_top = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer =
+      PrepareFor(request.config(), &k, &llm, &beams, &llm_top);
+  if (scorer == nullptr) return std::nullopt;
+  const auto t_load = std::chrono::steady_clock::now();
+
+  const std::string reading = ConversionReading(segments);
+  const std::string context = HistoryContext(request, segments);
+  // 候補 = ラティスの文全体の候補(区切り付き)+ zenz が読みから生成した文(区切りなし)。
+  std::vector<const converter::Candidate*> cands;
+  std::vector<std::string> values;
+  for (const converter::Candidate& c : sentences) {
+    if (c.key != reading || c.inner_segment_boundary.empty()) continue;
+    if (std::find(values.begin(), values.end(), c.value) != values.end()) {
+      continue;
+    }
+    cands.push_back(&c);
+    values.push_back(c.value);
+    if (cands.size() >= max_sentences_) break;
+  }
+  if (beams > 0 && Util::CharsLen(reading) <= 255) {
+    for (const std::string& g : scorer->Generate(context, reading, beams)) {
+      if (std::find(values.begin(), values.end(), g) != values.end()) continue;
+      // 読みを落とした文や、読みにない語を足した文を除く。
+      if (dictionary_ != nullptr &&
+          !MatchesReading(*dictionary_, single_kanji_, g, reading)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected %s\n", g.c_str());
+        }
+        continue;
+      }
+      cands.push_back(nullptr);
+      values.push_back(g);
+    }
+  }
+  const auto t_gen = std::chrono::steady_clock::now();
+  if (values.size() < 2) return std::nullopt;
+  // 点数 = zenz の log P(文 | 読み、前の文) + LLM の log P(文 | 前の文)(docs/adr/0016)。
+  // LLM がないときは zenz だけで選ぶ。
+  const std::optional<std::vector<float>> zlogp =
+      scorer->Score(context, reading, values);
+  if (!zlogp) return std::nullopt;
+  const auto t_zenz = std::chrono::steady_clock::now();
+  // LLM は zenz の点数の上位 llm_top 件だけを採点する(速さのため)。ほかは選ばない。
+  std::optional<std::vector<float>> llogp;
+  if (llm != nullptr) {
+    std::vector<size_t> order(values.size());
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+      return (*zlogp)[a] > (*zlogp)[b];
+    });
+    order.resize(std::min(order.size(), llm_top));
+    std::vector<std::string> subset;
+    for (size_t i : order) subset.push_back(values[i]);
+    if (auto sub = llm->Score(context, reading, subset)) {
+      llogp.emplace(values.size(), -std::numeric_limits<float>::infinity());
+      for (size_t j = 0; j < order.size(); ++j) (*llogp)[order[j]] = (*sub)[j];
+    }
+  }
+  const auto t_llm = std::chrono::steady_clock::now();
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(stderr,
+                 "[time] chars=%zu load=%.0fms gen=%.0fms zenz=%.0fms llm=%.0fms "
+                 "total=%.0fms gpu=%d llm_on=%d beams=%d cands=%zu\n",
+                 Util::CharsLen(reading), ms(t0, t_load), ms(t_load, t_gen),
+                 ms(t_gen, t_zenz), ms(t_zenz, t_llm), ms(t0, t_llm),
+                 LlamaHasGpu() ? 1 : 0, llm != nullptr ? 1 : 0, beams,
+                 values.size());
+  }
+  size_t top = 0;
+  double top_score = 0;
+  const bool debug = Env("KOTORI_LM_DEBUG") != nullptr;
+  for (size_t i = 0; i < values.size(); ++i) {
+    double s = lambda_lm_ * (*zlogp)[i];
+    if (llogp) s += lambda_llm_ * (*llogp)[i];
+    if (debug) {
+      std::fprintf(stderr, "[kotori] %s zenz=%.2f llm=%.2f %s score=%.2f\n",
+                   values[i].c_str(), (*zlogp)[i], llogp ? (*llogp)[i] : 0.f,
+                   cands[i] == nullptr ? "gen" : "lattice", s);
+    }
+    if (i == 0 || s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+
+  Best best{reading, context, {}, {}};
+  if (cands[top] == nullptr) {
+    // 生成した文は区切りを持たないので、全体を 1 つの文節にする。
+    best.keys.push_back(reading);
+    best.values.push_back(values[top]);
+  } else {
+    for (const auto& inner : cands[top]->inner_segments()) {
+      best.keys.emplace_back(inner.GetKey());
+      best.values.emplace_back(inner.GetValue());
+    }
+  }
+  if (best.keys.empty()) return std::nullopt;
+
+  // 今の区切りと同じなら、切り直さずに Rewrite で先頭を入れ替える。
+  std::vector<std::string> current;
+  for (const Segment& seg : segments.conversion_segments()) {
+    current.emplace_back(seg.key());
+  }
+  best_ = best;
+  if (current == best.keys) return std::nullopt;
+
+  ResizeSegmentsRequest resize;
+  resize.segment_index = 0;
+  const size_t n = std::min(best.keys.size(), resize.segment_sizes.size());
+  for (size_t i = 0; i < n; ++i) {
+    const size_t len = Util::CharsLen(best.keys[i]);
+    if (len == 0 || len > 255) {
+      best_.reset();
+      return std::nullopt;
+    }
+    resize.segment_sizes[i] = static_cast<uint8_t>(len);
+  }
+  return resize;
+}
+
+bool LmRewriter::ApplyBest(Segments* segments,
+                           const std::string& context) const {
+  if (!best_ || best_->context != context ||
+      best_->reading != ConversionReading(*segments)) {
+    return false;
+  }
+  size_t i = 0;
+  for (const Segment& seg : segments->conversion_segments()) {
+    if (i >= best_->keys.size() || seg.key() != best_->keys[i]) return false;
+    ++i;
+  }
+  if (i != best_->keys.size()) return false;
+
+  bool changed = false;
+  i = 0;
+  for (Segment& seg : segments->conversion_segments()) {
+    const std::string& value = best_->values[i++];
+    if (seg.candidates_size() == 0 || seg.candidate(0).value == value) {
+      continue;
+    }
+    int found = -1;
+    for (size_t j = 1; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == value) {
+        found = static_cast<int>(j);
+        break;
+      }
+    }
+    converter::Candidate c = seg.candidate(found >= 0 ? found : 0);
+    if (found >= 0) {
+      seg.erase_candidate(found);
+    } else {
+      // 文節の候補にない値(文全体の候補でだけ出たもの)は、先頭の候補を写して作る。
+      c.value = value;
+      c.content_value = value;
+      c.content_key = std::string(seg.key());
+      c.inner_segment_boundary.clear();
+    }
+    *seg.insert_candidate(0) = std::move(c);
+    changed = true;
+  }
+  return changed;
+}
+
+bool LmRewriter::RewriteEachSegment(const ConversionRequest& request,
+                                    ZenzScorer* scorer, size_t k,
+                                    Segments* segments) const {
+  std::string context = HistoryContext(request, *segments);
+  bool changed = false;
+  const size_t num_segments = segments->conversion_segments_size();
+  for (size_t s = 0; s < num_segments; ++s) {
+    Segment& seg = *segments->mutable_conversion_segment(s);
+    const size_t n = std::min(seg.candidates_size(), k);
+    if (n >= 2 && !seg.key().empty()) {
+      // 読みと候補の後ろに、残りの文節の読みと第 1 候補をつなぐ。「はが」だけでは
+      // 葉/歯を決められないが、「はがいたい」なら決められる。
+      std::string reading(seg.key());
+      std::string suffix;
+      if (right_context_) {
+        for (size_t t = s + 1; t < num_segments; ++t) {
+          const Segment& next = segments->conversion_segment(t);
+          if (next.candidates_size() == 0) break;
+          reading += next.key();
+          suffix += next.candidate(0).value;
+        }
+      }
+      std::vector<std::string> values;
+      values.reserve(n);
+      for (size_t i = 0; i < n; ++i) {
+        values.push_back(seg.candidate(i).value + suffix);
+      }
+      if (auto logp = scorer->Score(Tail(context), reading, values)) {
+        std::vector<double> score(n);
+        for (size_t i = 0; i < n; ++i) {
+          score[i] = Combine((*logp)[i], seg.candidate(i).cost);
+        }
+        std::vector<size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+          return score[a] > score[b];
+        });
+        std::vector<converter::Candidate> copies;
+        copies.reserve(n);
+        for (size_t i = 0; i < n; ++i) copies.push_back(seg.candidate(order[i]));
+        for (size_t i = 0; i < n; ++i) {
+          *seg.mutable_candidate(i) = std::move(copies[i]);
+        }
+        changed = changed || order[0] != 0;
+      }
+    }
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return changed;
+}
+
+bool LmRewriter::RewritePrediction(const ConversionRequest& request,
+                                   Segments* segments) const {
+  if (!predict_ || segments->conversion_segments_size() != 1) return false;
+  size_t k = 0, llm_top = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer =
+      PrepareFor(request.config(), &k, &llm, &beams, &llm_top);
+  if (scorer == nullptr || llm == nullptr) return false;
+  Segment& seg = *segments->mutable_conversion_segment(0);
+  const std::string reading(seg.key());
+  if (Util::CharsLen(reading) < 2) return false;
+  const auto t0 = std::chrono::steady_clock::now();
+  const std::string context = HistoryContext(request, *segments);
+  const std::vector<std::string> rchars = Chars(reading);
+  // 読みの変換(zenz。読みに合うもの)。
+  auto convert = [&](const std::string& r) -> std::string {
+    for (const std::string& g : scorer->Generate(context, r, 2)) {
+      if (dictionary_ == nullptr ||
+          MatchesReading(*dictionary_, single_kanji_, g, r)) {
+        return g;
+      }
+    }
+    return std::string();
+  };
+  const std::string conv = convert(reading);
+  if (conv.empty()) return false;
+  std::vector<std::string> values;
+  auto add = [&](const std::string& v) {
+    if (v != conv && std::find(values.begin(), values.end(), v) == values.end()) {
+      values.push_back(v);
+    }
+  };
+  // 続きの先頭が小書きのかなや長音のもの(「いいて」+「ぃ～んず」)は、語の途中で切れた
+  // 変換に無理につないだものなので除く。
+  auto natural_start = [](absl::string_view c) {
+    static constexpr absl::string_view kSmall[] = {
+        "ぁ", "ぃ", "ぅ", "ぇ", "ぉ", "ゃ", "ゅ", "ょ", "っ", "ゎ", "ー", "～",
+        "ァ", "ィ", "ゥ", "ェ", "ォ", "ャ", "ュ", "ョ", "ッ"};
+    for (absl::string_view k : kSmall) {
+      if (absl::StartsWith(c, k)) return false;
+    }
+    return !c.empty();
+  };
+  // 1. 読み全体の変換に、LLM で続きを付ける。
+  if (predict_mode_ & 1) for (const std::string& c :
+       llm->Continue(Tail(context) + conv, predict_tokens_, predict_beams_)) {
+    if (natural_start(c)) add(conv + c);
+  }
+  // 2. 最後の 1〜2 文字が打ちかけの場合(「きょうはいいて」→「今日はいい」+「て…」)。
+  //    その読みで始まる語を辞書から出やすい順に取り、LLM が文脈に合うものを選ぶ。
+  std::vector<std::string> partial;
+  for (size_t drop = 1; drop <= 2 && rchars.size() >= drop + 2; ++drop) {
+    std::string head, rest;
+    for (size_t i = 0; i < rchars.size(); ++i) {
+      (i + drop < rchars.size() ? head : rest) += rchars[i];
+    }
+    const std::string base = convert(head);
+    if (base.empty() || dictionary_ == nullptr) continue;
+    if (predict_mode_ & 2) {
+    // 打ちかけを除いた変換に LLM で続きを付け、読み全体で始まるものを残す
+    // (「お世話」+「になっております」)。
+    for (const std::string& c :
+         llm->Continue(Tail(context) + base, predict_tokens_, predict_beams_ + 1)) {
+      if (natural_start(c) &&
+          MatchesReading(*dictionary_, single_kanji_, base + c, reading, true)) {
+        add(base + c);
+      }
+    }
+    }
+    if (!(predict_mode_ & 4)) continue;
+    PredictiveCollector pc;
+    dictionary_->LookupPredictive(rest, &pc);
+    std::vector<std::pair<int, std::string>> words;
+    for (auto& [key, value, cost] : pc.tokens) {
+      if (Util::CharsLen(key) > Util::CharsLen(rest)) words.emplace_back(cost, value);
+    }
+    std::sort(words.begin(), words.end());
+    size_t taken = 0;
+    for (const auto& [cost, w] : words) {
+      const std::string v = base + w;
+      if (std::find(partial.begin(), partial.end(), v) != partial.end()) continue;
+      partial.push_back(v);
+      if (++taken >= 12) break;
+    }
+  }
+  if (!partial.empty()) {
+    if (auto logp = llm->Score(context, reading, partial)) {
+      std::vector<size_t> order(partial.size());
+      std::iota(order.begin(), order.end(), 0);
+      std::stable_sort(order.begin(), order.end(), [&](size_t x, size_t y) {
+        return (*logp)[x] / Util::CharsLen(partial[x]) >
+               (*logp)[y] / Util::CharsLen(partial[y]);
+      });
+      for (size_t n = 0; n < std::min<size_t>(2, order.size()); ++n) {
+        const std::string& p = partial[order[n]];
+        add(p);
+        // いちばんよいものには、さらに続きを付ける。
+        if (n == 0) {
+          for (const std::string& c : llm->Continue(Tail(context) + p, predict_tokens_, 2)) {
+            if (natural_start(c)) add(p + c);
+          }
+        }
+      }
+    }
+  }
+  // 3. Mozc 自身の予測候補(上位 8 件)も加え、前の文のもとでの自然さ(1 トークンあたりの
+  //    log P)で並べる。数字を含む候補(読みに数字がないとき)は除く。
+  std::vector<std::string> pool = values;
+  std::vector<bool> from_ai(pool.size(), true);
+  for (size_t j = 0; j < seg.candidates_size() && j < 8; ++j) {
+    const std::string& v = seg.candidate(j).value;
+    if (std::find(pool.begin(), pool.end(), v) == pool.end()) {
+      pool.push_back(v);
+      from_ai.push_back(false);
+    }
+  }
+  if (!conv.empty() && std::find(pool.begin(), pool.end(), conv) == pool.end()) {
+    pool.push_back(conv);
+    from_ai.push_back(true);
+  }
+  auto has_digit = [](absl::string_view v) {
+    for (const std::string& ch : Chars(v)) {
+      if ((ch.size() == 1 && std::isdigit(static_cast<unsigned char>(ch[0]))) ||
+          (ch >= "\xEF\xBC\x90" && ch <= "\xEF\xBC\x99" && ch.size() == 3)) {
+        return true;
+      }
+    }
+    return false;
+  };
+  std::vector<std::string> ranked;
+  if (auto logp = llm->Score(context, reading, pool)) {
+    std::vector<size_t> order;
+    std::vector<double> avg(pool.size());
+    for (size_t i = 0; i < pool.size(); ++i) {
+      if (has_digit(pool[i])) continue;
+      avg[i] = (*logp)[i] / std::max<size_t>(1, llm->CountTokens(pool[i]));
+      order.push_back(i);
+    }
+    std::stable_sort(order.begin(), order.end(),
+                     [&](size_t x, size_t y) { return avg[x] > avg[y]; });
+    for (size_t i : order) {
+      ranked.push_back(pool[i]);
+    }
+  }
+  const size_t shown = std::min<size_t>(ranked.size(), predict_beams_ + 1);
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(
+        stderr, "[predict] %.0fms pool=%zu shown=%zu\n",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - t0)
+            .count(),
+        pool.size(), shown);
+  }
+  if (shown == 0) return false;
+  // 上位を予測候補の先頭に置く。AI が作った候補の説明は「AI」。
+  converter::Candidate base;
+  if (seg.candidates_size() > 0) base = seg.candidate(0);
+  for (size_t i = 0; i < shown; ++i) {
+    std::optional<converter::Candidate> existing;
+    for (size_t j = 0; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == ranked[i]) {
+        existing = seg.candidate(j);
+        seg.erase_candidate(j);
+        break;
+      }
+    }
+    converter::Candidate c = existing.value_or(base);
+    if (!existing) {
+      c.key = reading;
+      c.content_key = reading;
+      c.value = ranked[i];
+      c.content_value = ranked[i];
+      c.consumed_key_size = Util::CharsLen(reading);
+      c.inner_segment_boundary.clear();
+      c.prefix.clear();
+      c.suffix.clear();
+      c.description = "AI";
+    }
+    *seg.insert_candidate(static_cast<int>(i)) = std::move(c);
+  }
+  return true;
+}
+
+bool LmRewriter::Rewrite(const ConversionRequest& request,
+                         Segments* segments) const {
+  absl::MutexLock lock(mutex_);
+  if (request.request_type() == ConversionRequest::PREDICTION) {
+    return RewritePrediction(request, segments);
+  }
+  size_t k = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = Prepare(request, &k, &llm, &beams);
+  if (scorer == nullptr) return false;
+  // 文全体で選んだ文が今の区切りに合えば、それを先頭に置く。
+  const bool applied =
+      sentence_ && ApplyBest(segments, HistoryContext(request, *segments));
+  if (applied && !post_segment_) return true;
+  // 文節ごとにも見直す(数字の書き方など、文全体の候補にない変種を比べる)。
+  return RewriteEachSegment(request, scorer, k, segments) || applied;
+}
+
+}  // namespace mozc
