+  const std::vector<converter::Candidate>& kotori_sentences() const {
+    return kotori_sentences_;
+  }
   void set_resized(bool resized) { resized_ = resized; }
 
   // Returns history key of `size` segments.
@@ -459,6 +468,7 @@ class Segments final {
   uint64_t revert_id_ = 0;
   uint32_t max_history_segments_size_ = 0;
   bool resized_ = false;
+  std::vector<converter::Candidate> kotori_sentences_;
   // LINT.ThenChange(//converter/segments_matchers.h)
 };
 
