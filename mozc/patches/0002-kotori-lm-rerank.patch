+LmRewriter::LmRewriter(const dictionary::DictionaryInterface* dictionary,
+                       const dictionary::SingleKanjiDictionary* single_kanji)
+    : dictionary_(dictionary), single_kanji_(single_kanji) {
+  if (const char* v = Env("KOTORI_LM_K")) {
+    k_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_SENTENCE")) sentence_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_POST")) post_segment_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_RIGHT")) right_context_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_THREADS")) {
+    threads_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_WEIGHTS")) {
+    double a, b, t;
+    if (std::sscanf(v, "%lf,%lf,%lf", &a, &b, &t) == 3 && t > 0) {
+      lambda_lm_ = a;
+      lambda_lattice_ = b;
+      temperature_ = t;
+    }
+  }
+  if (const char* v = Env("KOTORI_ZENZ_MODEL")) env_model_path_ = v;
+  if (const char* v = Env("KOTORI_LLM_MODEL")) env_llm_path_ = v;
+  if (const char* v = Env("KOTORI_ZENZ_EXTRA_MODEL")) env_extra_path_ = v;
+  if (const char* v = Env("KOTORI_LM_BEAMS")) beams_override_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT")) predict_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_PREDICT_MODE")) predict_mode_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PREDICT_TOKENS")) {
+    predict_tokens_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_PREDICT_BEAMS")) {
+    predict_beams_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_TOP")) {
+    llm_top_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_LIGHT_BEAMS")) {
+    std::sscanf(v, "%d,%d,%d", &light_beams_, &light_head_beams_, &light_tokens_);
+  }
+  if (const char* v = Env("KOTORI_LM_LIGHT_RANK")) light_rank_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_LIGHT_DELAY")) light_delay_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_FULL_DELAY")) full_delay_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_CPU_LONG")) cpu_long_chars_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_ZENZ_LONG_MODEL")) env_long_path_ = v;
+  if (const char* v = Env("KOTORI_LM_IDLE_UNLOAD")) {
+    idle_unload_ms_ = std::max(0, std::atoi(v)) * 1000;
+  }
+  last_activity_us_ = SteadyNowUs();
+  if (const char* v = Env("KOTORI_LM_NSENT")) {
+    max_sentences_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_LLM_WEIGHT")) lambda_llm_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_GEN_PENALTY")) gen_penalty_ = std::atof(v);
+  if (const char* v = Env("KOTORI_LM_GEN_PENALTY_LLM")) {
+    gen_penalty_llm_ = std::atof(v);
+  }
+  model_dir_ = SystemUtil::GetServerDirectory();
+  // llama.cpp の DLL とモデルのフォルダ(評価用に差し替えられる)。
+  runtime_dir_ = model_dir_;
+  if (const char* v = Env("KOTORI_RUNTIME_DIR")) runtime_dir_ = v;
+  if (const char* v = Env("KOTORI_MODEL_DIR")) model_dir_ = v;
+  if (const char* v = Env("KOTORI_LM_BUDGET")) budget_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_PRECONVERT")) preconvert_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_TAB_BUDGET")) tab_budget_ms_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_SPLIT")) split_generated_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_FILTER_JUNK")) filter_junk_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_TAB_SHOW")) tab_show_ = std::atoi(v);
+  if (const char* v = Env("KOTORI_LM_MIN_CONTINUATION")) {
+    min_continuation_chars_ = std::atoi(v);
+  }
+  // モデルの読み込みと、入力中のサジェストに出す予測を裏で行うスレッド。
+  worker_ = std::thread([this] { WorkerLoop(); });
+  // 今の設定のモデルを裏で読み込んでおく(最初の変換で 1 秒以上待たないため)。
+  // KOTORI_LM_PRELOAD=0(評価)なら、要求の中で読み込む(読み込みを待ってから変換する)。
+  const char* preload = Env("KOTORI_LM_PRELOAD");
+  sync_load_ = preload != nullptr && *preload == '0';
+  if (!sync_load_) RequestLoad(config::ConfigHandler::GetCopiedConfig());
+}
+
+void LmRewriter::WriteStatus(const config::Config& config,
+                             const char* state) const {
+  if (sync_load_) return;  // 評価では書かない
+  // 1 行に 1 項目(キー=値)。入力した文字は書かない。
+  std::string text;
+  auto line = [&](absl::string_view key, absl::string_view value) {
+    absl::StrAppend(&text, key, "=", value, "\n");
+  };
+  auto base = [](const std::string& path) {
+    const size_t p = path.find_last_of("/\\");
+    return p == std::string::npos ? path : path.substr(p + 1);
+  };
+  const bool runtime = EnsureLlamaRuntime(runtime_dir_);
+  const std::string gpu = runtime ? LlamaGpuName() : std::string();
+  if (!config.kotori_lm_enabled()) {
+    line("state", "off");
+  } else if (std::string(state) == "loading") {
+    line("state", "loading");
+  } else if (std::string(state) == "sleep") {
+    line("state", "sleep");
+  } else if (!runtime) {
+    line("state", "error");
+    line("message", "llama.dll");
+  } else if (scorer_ == nullptr) {
+    line("state", "error");
+    line("message", base(loaded_path_));
+  } else {
+    line("state", llm_ != nullptr ? "llm" : "zenz");
+  }
+  line("device", gpu.empty() ? "CPU" : gpu);
+  if (scorer_ != nullptr) line("zenz", base(loaded_path_));
+  if (llm_ != nullptr) line("llm", base(llm_path_));
+  const std::string path =
+      FileUtil::JoinPath(SystemUtil::GetUserProfileDirectory(),
+                         "kotori_ai_status.txt");
+  std::ofstream out(path, std::ios::binary | std::ios::trunc);
+  out << text;
+}
+
+void LmRewriter::RequestLoad(const config::Config& config) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  load_job_ = config;
+  job_cv_.notify_one();
+}
+
+void LmRewriter::Touch(const config::Config& config) const {
+  last_activity_us_ = SteadyNowUs();
+  if (config.kotori_lm_enabled() && sleeping_.exchange(false)) {
+    RequestLoad(config);
+  }
+}
+
+void LmRewriter::UnloadIfIdle(const config::Config& config) const {
+  if (idle_unload_ms_ <= 0 || sync_load_ || sleeping_.load() || loading_.load()) {
+    return;
+  }
+  if (SteadyNowUs() - last_activity_us_.load() <
+      static_cast<int64_t>(idle_unload_ms_) * 1000) {
+    return;
+  }
+  // 要求の最中なら外さない(次の確かめで外す)。
+  if (!mutex_.TryLock()) return;
+  const bool any = scorer_ != nullptr || llm_ != nullptr || extra_ != nullptr ||
+                   long_scorer_ != nullptr;
+  if (any) {
+    scorer_.reset();
+    llm_.reset();
+    extra_.reset();
+    long_scorer_.reset();
+    loaded_ = llm_loaded_ = extra_loaded_ = long_loaded_ = false;
+    long_path_.clear();
+    loaded_path_.clear();
+    llm_path_.clear();
+    extra_path_.clear();
+    gen_cache_.reset();
+    sleeping_ = true;
+    WriteStatus(config, "sleep");
+  }
+  mutex_.Unlock();
+  if (!any) return;
+  // 覚えておいた予測(入力した文字を含む)も捨てる。
+  ClearPredictions();
+  std::lock_guard<std::mutex> lock(job_mu_);
+  last_converted_key_.clear();
+}
+
+bool LmRewriter::TryLockForRequest(int wait_ms) const {
+  // モデルの読み込み中は待たない(ノート PC では数秒かかり、変換が固まる。docs/adr/0024)。
+  if (loading_.load()) return false;
+  // 裏の予測は urgent_ を見て 1 トークンごとにやめるので、少しだけ待つ(同じ読みの先回りの
+  // 変換は、やめずに終わるのを待つ)。
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(wait_ms);
+  while (!mutex_.TryLock()) {
+    if (loading_.load() || std::chrono::steady_clock::now() > deadline) {
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  return true;
+}
