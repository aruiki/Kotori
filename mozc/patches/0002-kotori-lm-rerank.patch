+void LmRewriter::ClearPredictions() const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  cache_.clear();
+  if (job_ && !job_->convert) job_.reset();
+}
+
+bool LmRewriter::HasGpu() const {
+  return EnsureLlamaRuntime(runtime_dir_) && LlamaHasGpu();
+}
+
+bool LmRewriter::UsesLlm(const config::Config& config) const {
+  // AI モデルが「zenz のみ」でなく、AI を載せられる GPU があるとき(docs/adr/0016、0024)。
+  return config.kotori_lm_model() != config::Config::KOTORI_LM_MODEL_ZENZ &&
+         HasGpu();
+}
+
+int LmRewriter::BudgetMs() const {
+  // 変換で AI に使う時間の上限。GPU がないときは短くする(CPU では生成が遅く、待たせないため)。
+  if (budget_ms_ >= 0) return budget_ms_;
+  return HasGpu() ? 2000 : 600;
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::CheckResizeSegmentsRequest(const ConversionRequest& request,
+                                       const Segments& segments) const {
+  // サジェストのための変換(予測の中のリアルタイム変換。1 打鍵ごとに来る)では動かない。
+  if (!sentence_ || request.request_type() != ConversionRequest::CONVERSION ||
+      request.options().skip_slow_rewriters) {
+    return std::nullopt;
+  }
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[kotori] sentences=%zu segments=%zu\n",
+                 sentences.size(), segments.conversion_segments_size());
+  }
+  // 文全体の候補は、区切りが決まっていない最初の変換のときだけある(切り直した後の変換では空)。
+  if (sentences.empty()) return std::nullopt;
+  const std::string reading = ConversionReading(segments);
+  const std::string context = HistoryContext(request, segments);
+  const std::string key = reading + "\t" + context;
+  if (!HasGpu() && Util::CharsLen(reading) > kMaxCpuChars) return std::nullopt;
+  const auto t_request = std::chrono::steady_clock::now();
+  Urgent urgent(urgent_, last_request_us_);
+  // 同じ読みの先回りの変換が裏で計算中なら、捨てずに終わるのを待つ(上限まで)。
+  int wait_ms = 300;
+  {
+    std::lock_guard<std::mutex> jl(job_mu_);
+    urgent_key_ = key;
+    last_converted_key_ = key;
+    if (running_convert_ == key) wait_ms = std::max(wait_ms, BudgetMs());
+  }
+  if (!TryLockForRequest(wait_ms)) return std::nullopt;
+  HeldLock lock(mutex_);
+  best_.reset();
+  const auto t0 = std::chrono::steady_clock::now();
+  // AI に使う時間の上限(モデルを用意した後から数える)。超えたら生成をやめ、LLM も使わない
+  // (遅い PC で固まらないため)。
+  std::chrono::steady_clock::time_point deadline, gen_deadline;
+  int budget_ms = 0;
+  auto over = [&] {
+    return budget_ms > 0 && std::chrono::steady_clock::now() > deadline;
+  };
+  // 生成は上限の 6 割までにし、残りを採点に残す(採点の 1 回の計算は途中でやめられないため。
+  // docs/adr/0029)。
+  auto gen_over = [&] {
+    return budget_ms > 0 && std::chrono::steady_clock::now() > gen_deadline;
+  };
+  auto ms = [](auto a, auto b) {
+    return std::chrono::duration<double, std::milli>(b - a).count();
+  };
+  size_t k = 0;
+  int beams = 0;
+  size_t llm_top = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = PrepareFor(request.config(), &k, &llm, &beams, &llm_top,
+                                  false, sync_load_, Util::CharsLen(reading));
+  if (scorer == nullptr) return std::nullopt;
+  const auto t_load = std::chrono::steady_clock::now();
+  budget_ms = BudgetMs();
+  // 上限は要求が来た時点から数える(ロックを待った時間も含める)。この要求の中でモデルを読み込んだ
+  // とき(評価)は、読み込みの後から数える。
+  const auto t_budget =
+      t_load - t0 > std::chrono::milliseconds(50) ? t_load : t_request;
+  deadline = t_budget + std::chrono::milliseconds(budget_ms);
+  gen_deadline = t_budget + std::chrono::milliseconds(budget_ms * 6 / 10);
+
+  // 候補 = ラティスの文全体の候補(区切り付き)+ zenz が読みから生成した文(区切りなし)。
+  std::vector<const converter::Candidate*> cands;
+  std::vector<std::string> values;
+  for (const converter::Candidate& c : sentences) {
+    if (c.key != reading || c.inner_segment_boundary.empty()) continue;
+    if (std::find(values.begin(), values.end(), c.value) != values.end()) {
+      continue;
+    }
+    cands.push_back(&c);
+    values.push_back(c.value);
+    if (cands.size() >= max_sentences_) break;
+  }
+  // ユーザー辞書の語を含む文が Mozc の 1 位なら、利用者が登録した表記を AI で変えない
+  // (docs/adr/0027、改善案 07)。
+  if (!cands.empty() && cands.front() != nullptr &&
+      (cands.front()->attributes & converter::Attribute::USER_DICTIONARY)) {
+    return std::nullopt;
+  }
+  // ラティスの 1 位のひらがなの数。生成した文がこれより 4 文字以上多ければ、読みを漢字に変えずに
+  // 写しただけとみなして除く(zenz は読みを写した文を高く採点することがある)。
+  const size_t lattice_kana =
+      values.empty() ? SIZE_MAX : CountKana(values.front());
+  std::vector<std::string> generated;
+  if (beams > 0 && Util::CharsLen(reading) <= kMaxGenerateChars) {
+    if (gen_cache_ && gen_cache_->key == key && gen_cache_->beams == beams &&
+        gen_cache_->model == ModelKey(scorer)) {
+      generated = gen_cache_->texts;  // 先回りの変換で作ったもの
+    } else {
+      {
+        CancelScope cancel(gen_over);
+        generated = scorer->Generate(context, reading, beams);
+        // 2 つ目の zenz(Unreal)でも生成し、候補を合わせる(docs/adr/0031)。
+        {
+          if (extra_ != nullptr && !gen_over()) {
+            for (std::string& g : extra_->Generate(context, reading, beams)) {
+              if (std::find(generated.begin(), generated.end(), g) ==
+                  generated.end()) {
+                generated.push_back(std::move(g));
+              }
+            }
+          }
+        }
+      }
+      // 裏の先回りの変換が同じ読みを作り直さないように残す(途中でやめたものは残さない)。
+      if (!gen_over()) gen_cache_ = Generated{key, beams, loaded_path_ + "|" + extra_path_, generated};
+    }
+  }
+  {
+    for (const std::string& g : generated) {
+      if (std::find(values.begin(), values.end(), g) != values.end()) continue;
+      if ((lattice_kana != SIZE_MAX && CountKana(g) >= lattice_kana + 4) ||
+          HasStraySmallKana(g)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected (kana) %s\n", g.c_str());
+        }
+        continue;
+      }
+      // 読みを落とした文や、読みにない語を足した文を除く。
+      if (dictionary_ != nullptr &&
+          !MatchesReading(*dictionary_, single_kanji_, g, reading)) {
+        if (Env("KOTORI_LM_DEBUG") != nullptr) {
+          std::fprintf(stderr, "[kotori] rejected %s\n", g.c_str());
+        }
+        continue;
+      }
+      cands.push_back(nullptr);
+      values.push_back(g);
+    }
+  }
+  const auto t_gen = std::chrono::steady_clock::now();
+  // 生成で時間を使い切ったら、採点もせずに Mozc の結果を出す(待たせないため)。
+  if (values.size() < 2 || gen_over()) return std::nullopt;
+  // 点数 = zenz の log P(文 | 読み、前の文) + LLM の log P(文 | 前の文)(docs/adr/0016)。
+  // LLM がないときは zenz だけで選ぶ。
+  const std::optional<std::vector<float>> zlogp =
+      scorer->Score(context, reading, values);
+  if (!zlogp) return std::nullopt;
+  const auto t_zenz = std::chrono::steady_clock::now();
+  // LLM は zenz の点数の上位 llm_top 件だけを採点する(速さのため)。ほかは選ばない。
+  // 時間の上限を超えていたら使わない。
+  std::optional<std::vector<float>> llogp;
+  if (llm != nullptr && !over()) {
+    std::vector<size_t> order(values.size());
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+      return (*zlogp)[a] > (*zlogp)[b];
+    });
+    order.resize(std::min(order.size(), llm_top));
+    // ラティスの 1 位は必ず採点する(zenz が生成を高く見積もっても、Mozc の答えと比べられるように)。
+    if (cands.front() != nullptr &&
+        std::find(order.begin(), order.end(), 0) == order.end()) {
+      order.push_back(0);
+    }
+    std::vector<std::string> subset;
+    for (size_t i : order) subset.push_back(values[i]);
+    if (auto sub = llm->Score(context, reading, subset)) {
+      llogp.emplace(values.size(), -std::numeric_limits<float>::infinity());
+      for (size_t j = 0; j < order.size(); ++j) (*llogp)[order[j]] = (*sub)[j];
+    }
+  }
+  const auto t_llm = std::chrono::steady_clock::now();
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(stderr,
+                 "[time] chars=%zu load=%.0fms gen=%.0fms zenz=%.0fms llm=%.0fms "
+                 "total=%.0fms gpu=%d llm_on=%d beams=%d cands=%zu\n",
+                 Util::CharsLen(reading), ms(t0, t_load), ms(t_load, t_gen),
+                 ms(t_gen, t_zenz), ms(t_zenz, t_llm), ms(t0, t_llm),
+                 LlamaHasGpu() ? 1 : 0, llm != nullptr ? 1 : 0, beams,
+                 values.size());
+  }
+  size_t top = 0;
+  double top_score = 0;
+  const bool debug = Env("KOTORI_LM_DEBUG") != nullptr;
+  for (size_t i = 0; i < values.size(); ++i) {
+    double s = lambda_lm_ * (*zlogp)[i];
+    if (llogp) s += lambda_llm_ * (*llogp)[i];
+    // 生成した文は辞書の表記を通らないので、同じくらいの点ならラティスの文を選ぶ。
+    if (cands[i] == nullptr) s -= llogp ? gen_penalty_llm_ : gen_penalty_;
+    if (debug) {
+      std::fprintf(stderr, "[kotori] %s zenz=%.2f llm=%.2f %s score=%.2f\n",
+                   values[i].c_str(), (*zlogp)[i], llogp ? (*llogp)[i] : 0.f,
+                   cands[i] == nullptr ? "gen" : "lattice", s);
+    }
+    if (i == 0 || s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+
+  Best best{reading, context, {}, {}};
+  if (cands[top] == nullptr) {
+    // 生成した文は区切りを持たないので、表記と読みの対応で文節に分ける(一語だけ直しやすく
+    // するため)。対応が取れないときや分割を切ったときは、全体を 1 つの文節にする。
+    std::vector<std::pair<std::string, std::string>> units;
+    if (split_generated_ && dictionary_ != nullptr &&
+        MatchesReading(*dictionary_, single_kanji_, values[top], reading, false,
+                       &units)) {
+      SplitIntoSegmentsImpl(units, ResizeSegmentsRequest().segment_sizes.size(),
+                            &best.keys, &best.values);
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        for (const auto& [ut, ur] : units) {
+          std::fprintf(stderr, "[kotori] unit %s/%s\n", ut.c_str(), ur.c_str());
+        }
+      }
+    }
+    if (best.keys.empty() || absl::StrJoin(best.keys, "") != reading ||
+        absl::StrJoin(best.values, "") != values[top]) {
+      best.keys = {reading};
+      best.values = {values[top]};
+    }
+  } else {
+    for (const auto& inner : cands[top]->inner_segments()) {
+      best.keys.emplace_back(inner.GetKey());
+      best.values.emplace_back(inner.GetValue());
+    }
+  }
+  if (best.keys.empty()) return std::nullopt;
+
+  // 今の区切りと同じなら、切り直さずに Rewrite で先頭を入れ替える。
+  std::vector<std::string> current;
+  for (const Segment& seg : segments.conversion_segments()) {
+    current.emplace_back(seg.key());
+  }
+  best_ = best;
+  if (current == best.keys) return std::nullopt;
+
+  ResizeSegmentsRequest resize;
+  resize.segment_index = 0;
+  const size_t n = std::min(best.keys.size(), resize.segment_sizes.size());
+  for (size_t i = 0; i < n; ++i) {
+    const size_t len = Util::CharsLen(best.keys[i]);
+    if (len == 0 || len > 255) {
+      best_.reset();
+      return std::nullopt;
+    }
+    resize.segment_sizes[i] = static_cast<uint8_t>(len);
+  }
+  return resize;
+}
+
+bool LmRewriter::ApplyBest(Segments* segments, const std::string& context,
+                           bool* changed_out) const {
+  *changed_out = false;
+  if (!best_ || best_->context != context ||
+      best_->reading != ConversionReading(*segments)) {
+    return false;
+  }
+  size_t i = 0;
+  for (const Segment& seg : segments->conversion_segments()) {
+    if (i >= best_->keys.size() || seg.key() != best_->keys[i]) return false;
+    ++i;
+  }
+  if (i != best_->keys.size()) return false;
+
+  bool changed = false;
+  i = 0;
+  for (Segment& seg : segments->conversion_segments()) {
+    const std::string& value = best_->values[i++];
+    if (seg.candidates_size() == 0 || seg.candidate(0).value == value) {
+      continue;
+    }
+    // ユーザー辞書の語は置き換えない。
+    if (seg.candidate(0).attributes & converter::Attribute::USER_DICTIONARY) {
+      continue;
+    }
+    int found = -1;
+    for (size_t j = 1; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == value) {
+        found = static_cast<int>(j);
+        break;
+      }
+    }
+    converter::Candidate c = seg.candidate(found >= 0 ? found : 0);
+    if (found >= 0) {
+      seg.erase_candidate(found);
+    } else {
+      // 文節の候補にない値(文全体の候補でだけ出たもの)は、先頭の候補を写して作る。
+      c.value = value;
+      c.content_value = value;
+      c.content_key = std::string(seg.key());
+      c.inner_segment_boundary.clear();
+    }
+    *seg.insert_candidate(0) = std::move(c);
+    changed = true;
+  }
+  *changed_out = changed;
+  return true;
+}
+
+bool LmRewriter::RewriteEachSegment(
+    const ConversionRequest& request, ZenzScorer* scorer, size_t k,
+    bool keep_top, std::chrono::steady_clock::time_point deadline,
+    Segments* segments) const {
+  std::string context = HistoryContext(request, *segments);
+  bool changed = false;
+  const size_t num_segments = segments->conversion_segments_size();
+  for (size_t s = 0; s < num_segments; ++s) {
+    Segment& seg = *segments->mutable_conversion_segment(s);
+    const size_t n = std::min(seg.candidates_size(), k);
+    if (BudgetMs() > 0 && std::chrono::steady_clock::now() > deadline) break;
+    // ユーザー辞書の語が 1 位の文節は並べ替えない。
+    const bool user_top =
+        seg.candidates_size() > 0 &&
+        (seg.candidate(0).attributes & converter::Attribute::USER_DICTIONARY);
+    if (n >= 2 && !seg.key().empty() && !user_top) {
+      // 読みと候補の後ろに、残りの文節の読みと第 1 候補をつなぐ。「はが」だけでは
+      // 葉/歯を決められないが、「はがいたい」なら決められる。
+      std::string reading(seg.key());
+      std::string suffix;
+      if (right_context_) {
+        for (size_t t = s + 1; t < num_segments; ++t) {
+          const Segment& next = segments->conversion_segment(t);
+          if (next.candidates_size() == 0) break;
+          reading += next.key();
+          suffix += next.candidate(0).value;
+        }
+      }
+      std::vector<std::string> values;
+      values.reserve(n);
+      for (size_t i = 0; i < n; ++i) {
+        values.push_back(seg.candidate(i).value + suffix);
+      }
+      if (auto logp = scorer->Score(Tail(context), reading, values)) {
+        std::vector<double> score(n);
+        for (size_t i = 0; i < n; ++i) {
+          score[i] = Combine((*logp)[i], seg.candidate(i).cost);
+        }
+        std::vector<size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        // keep_top なら先頭(文全体で選んだもの)は動かさず、2 番目以降だけ並べる。
+        std::stable_sort(order.begin() + (keep_top ? 1 : 0), order.end(),
+                         [&](size_t a, size_t b) { return score[a] > score[b]; });
+        std::vector<converter::Candidate> copies;
+        copies.reserve(n);
+        for (size_t i = 0; i < n; ++i) copies.push_back(seg.candidate(order[i]));
+        for (size_t i = 0; i < n; ++i) {
+          *seg.mutable_candidate(i) = std::move(copies[i]);
+        }
+        changed = changed || order[0] != 0;
+      }
+    }
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return changed;
+}
+
+namespace {
+
+// 続きの先頭が小書きのかなや長音のもの(「いいて」+「ぃ～んず」)は、語の途中で切れた
+// 変換に無理につないだものなので除く。
+bool NaturalStart(absl::string_view c) {
+  static constexpr absl::string_view kSmall[] = {
+      "ぁ", "ぃ", "ぅ", "ぇ", "ぉ", "ゃ", "ゅ", "ょ", "っ", "ゎ", "ー", "～",
+      "ァ", "ィ", "ゥ", "ェ", "ォ", "ャ", "ュ", "ョ", "ッ"};
+  for (absl::string_view k : kSmall) {
+    if (absl::StartsWith(c, k)) return false;
+  }
+  return !c.empty();
+}
+
+// 予測に出さない候補(入力の邪魔になるだけのもの。docs/adr/0030)。
+// - 続き(continuation)に開き括弧・引用符がある(「日本語教育 のように別の文へ脱線したもの)。
+// - 読みにひらがながあるのに、全部カタカナ(読みを写しただけ)。
+bool IsJunkPrediction(absl::string_view text, absl::string_view continuation,
+                      absl::string_view reading) {
+  static constexpr absl::string_view kOpen[] = {
+      "\xE3\x80\x8C", "\xE3\x80\x8E", "\xEF\xBC\x88", "\xE3\x80\x90",
+      "\xE3\x80\x88", "\xE3\x80\x8A", "(", "[", "\""};  // 「『(【〈《
+  for (absl::string_view o : kOpen) {
+    if (absl::StrContains(continuation, o)) return true;
+  }
+  auto kind = [](const std::string& c) {
+    if (c.size() != 3 || static_cast<unsigned char>(c[0]) != 0xE3) return 0;
+    const uint32_t cp =
+        ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+    if (cp >= 0x3041 && cp <= 0x309F) return 1;  // ひらがな
+    if (cp >= 0x30A1 && cp <= 0x30FA) return 2;  // カタカナ
+    return 0;
+  };
+  bool reading_hira = false;
+  for (const std::string& c : Chars(reading)) reading_hira |= kind(c) == 1;
+  bool all_kata = true;
+  for (const std::string& c : Chars(text)) {
+    if (kind(c) != 2 && c != "\xE3\x83\xBC") {  // 長音はカタカナとみなす
+      all_kata = false;
+      break;
+    }
+  }
+  return reading_hira && all_kata;
+}
+
+bool HasDigit(absl::string_view v) {
+  for (const std::string& ch : Chars(v)) {
+    if ((ch.size() == 1 && std::isdigit(static_cast<unsigned char>(ch[0]))) ||
+        (ch.size() == 3 && ch >= "\xEF\xBC\x90" && ch <= "\xEF\xBC\x99")) {
+      return true;
+    }
+  }
+  return false;
+}
