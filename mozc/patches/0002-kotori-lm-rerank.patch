+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/llama_runtime.h"
+
+#include <string>
+
+#include "llama.h"
+
+#ifdef _WIN32
+#include <windows.h>
+
+#include "ggml-backend.h"
+#endif  // _WIN32
+
+namespace mozc {
+namespace {
+
+void QuietLog(ggml_log_level, const char*, void*) {}
+
+}  // namespace
+
+#ifndef _WIN32
+
+bool EnsureLlamaRuntime(const std::string& dir) {
+  static const bool ok = [] {
+    llama_log_set(QuietLog, nullptr);
+    llama_backend_init();
+    return true;
+  }();
+  return ok;
+}
+
+bool LlamaHasGpu() { return llama_supports_gpu_offload(); }
+
+#else  // _WIN32
+
+// llama.dll と ggml.dll の関数を実行時に引く。インポートライブラリを使わないので、
+// DLL がなくても mozc_server は起動でき、そのときは AI なしで変換する。
+namespace {
+
+#define KOTORI_LLAMA_FUNCTIONS(X)                                              \
+  X(llama_log_set)                                                             \
+  X(llama_backend_init)                                                        \
+  X(llama_model_default_params)                                                \
+  X(llama_model_load_from_file)                                                \
+  X(llama_model_free)                                                          \
+  X(llama_context_default_params)                                              \
+  X(llama_init_from_model)                                                     \
+  X(llama_free)                                                                \
+  X(llama_model_get_vocab)                                                     \
+  X(llama_vocab_n_tokens)                                                      \
+  X(llama_vocab_eos)                                                           \
+  X(llama_vocab_bos)                                                           \
+  X(llama_vocab_get_add_bos)                                                   \
+  X(llama_tokenize)                                                            \
+  X(llama_get_memory)                                                          \
+  X(llama_memory_clear)                                                        \
+  X(llama_memory_seq_cp)                                                       \
+  X(llama_memory_seq_rm)                                                       \
+  X(llama_token_to_piece)                                                      \
+  X(llama_batch_init)                                                          \
+  X(llama_batch_free)                                                          \
+  X(llama_decode)                                                              \
+  X(llama_get_logits_ith)                                                      \
+  X(llama_supports_gpu_offload)
+
+struct Api {
+#define KOTORI_DECLARE(name) decltype(&::name) name = nullptr;
+  KOTORI_LLAMA_FUNCTIONS(KOTORI_DECLARE)
+#undef KOTORI_DECLARE
+  decltype(&::ggml_backend_load_all_from_path) load_all = nullptr;
+};
+
+Api g_api;
+bool g_loaded = false;
+
+std::wstring Widen(const std::string& s) {
+  if (s.empty()) return std::wstring();
+  const int n = MultiByteToWideChar(CP_UTF8, 0, s.data(),
+                                    static_cast<int>(s.size()), nullptr, 0);
+  std::wstring w(n, L'\0');
+  MultiByteToWideChar(CP_UTF8, 0, s.data(), static_cast<int>(s.size()),
+                      w.data(), n);
+  return w;
+}
+
+bool Load(const std::string& dir) {
+  const std::wstring wdir = Widen(dir);
+  // 同梱の DLL だけを探す(カレントディレクトリや PATH の DLL を読まない)。
+  constexpr DWORD kFlags =
+      LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32;
+  HMODULE ggml = LoadLibraryExW((wdir + L"\\ggml.dll").c_str(), nullptr, kFlags);
+  HMODULE llama =
+      LoadLibraryExW((wdir + L"\\llama.dll").c_str(), nullptr, kFlags);
+  if (ggml == nullptr || llama == nullptr) return false;
+#define KOTORI_RESOLVE(name)                                              \
+  g_api.name = reinterpret_cast<decltype(g_api.name)>(                    \
+      GetProcAddress(llama, #name));                                      \
+  if (g_api.name == nullptr) return false;
+  KOTORI_LLAMA_FUNCTIONS(KOTORI_RESOLVE)
+#undef KOTORI_RESOLVE
+  g_api.load_all = reinterpret_cast<decltype(g_api.load_all)>(
+      GetProcAddress(ggml, "ggml_backend_load_all_from_path"));
+  if (g_api.load_all == nullptr) return false;
+  g_api.llama_log_set(QuietLog, nullptr);
+  // GPU(Vulkan)と CPU の DLL のうち、この PC で使えるものを読み込む。
+  g_api.load_all(dir.c_str());
+  g_api.llama_backend_init();
+  return true;
+}
+
+}  // namespace
+
+bool EnsureLlamaRuntime(const std::string& dir) {
+  static const bool ok = [&dir] {
+    g_loaded = Load(dir);
+    return g_loaded;
+  }();
+  return ok;
+}
+
+bool LlamaHasGpu() {
+  return g_loaded && g_api.llama_supports_gpu_offload();
+}
+
+#endif  // _WIN32
+
+}  // namespace mozc
+
+#ifdef _WIN32
+// zenz_scorer.cc などが呼ぶ llama.cpp の関数。読み込んだ DLL の関数へ渡す。
+// EnsureLlamaRuntime が true を返した後にだけ呼ばれる。
+using mozc::g_api;
+extern "C" {
+void llama_log_set(ggml_log_callback cb, void* data) {
+  g_api.llama_log_set(cb, data);
+}
+void llama_backend_init(void) { g_api.llama_backend_init(); }
+llama_model_params llama_model_default_params(void) {
+  return g_api.llama_model_default_params();
+}
+llama_model* llama_model_load_from_file(const char* path,
+                                        llama_model_params params) {
+  return g_api.llama_model_load_from_file(path, params);
+}
+void llama_model_free(llama_model* model) { g_api.llama_model_free(model); }
+llama_context_params llama_context_default_params(void) {
+  return g_api.llama_context_default_params();
+}
+llama_context* llama_init_from_model(llama_model* model,
+                                     llama_context_params params) {
+  return g_api.llama_init_from_model(model, params);
+}
+void llama_free(llama_context* ctx) { g_api.llama_free(ctx); }
+const llama_vocab* llama_model_get_vocab(const llama_model* model) {
+  return g_api.llama_model_get_vocab(model);
+}
+int32_t llama_vocab_n_tokens(const llama_vocab* vocab) {
+  return g_api.llama_vocab_n_tokens(vocab);
+}
+llama_token llama_vocab_eos(const llama_vocab* vocab) {
+  return g_api.llama_vocab_eos(vocab);
+}
+llama_token llama_vocab_bos(const llama_vocab* vocab) {
+  return g_api.llama_vocab_bos(vocab);
+}
+bool llama_vocab_get_add_bos(const llama_vocab* vocab) {
+  return g_api.llama_vocab_get_add_bos(vocab);
+}
+int32_t llama_tokenize(const llama_vocab* vocab, const char* text,
+                       int32_t text_len, llama_token* tokens,
+                       int32_t n_tokens_max, bool add_special,
+                       bool parse_special) {
+  return g_api.llama_tokenize(vocab, text, text_len, tokens, n_tokens_max,
+                              add_special, parse_special);
+}
+llama_memory_t llama_get_memory(const llama_context* ctx) {
+  return g_api.llama_get_memory(ctx);
+}
+void llama_memory_clear(llama_memory_t mem, bool data) {
+  g_api.llama_memory_clear(mem, data);
+}
+void llama_memory_seq_cp(llama_memory_t mem, llama_seq_id src,
+                         llama_seq_id dst, llama_pos p0, llama_pos p1) {
+  g_api.llama_memory_seq_cp(mem, src, dst, p0, p1);
+}
+bool llama_memory_seq_rm(llama_memory_t mem, llama_seq_id seq, llama_pos p0,
+                         llama_pos p1) {
+  return g_api.llama_memory_seq_rm(mem, seq, p0, p1);
+}
+int32_t llama_token_to_piece(const llama_vocab* vocab, llama_token token,
+                             char* buf, int32_t length, int32_t lstrip,
+                             bool special) {
+  return g_api.llama_token_to_piece(vocab, token, buf, length, lstrip,
+                                    special);
+}
+llama_batch llama_batch_init(int32_t n_tokens, int32_t embd,
+                             int32_t n_seq_max) {
+  return g_api.llama_batch_init(n_tokens, embd, n_seq_max);
+}
+void llama_batch_free(llama_batch batch) { g_api.llama_batch_free(batch); }
+int32_t llama_decode(llama_context* ctx, llama_batch batch) {
+  return g_api.llama_decode(ctx, batch);
+}
+float* llama_get_logits_ith(llama_context* ctx, int32_t i) {
+  return g_api.llama_get_logits_ith(ctx, i);
+}
+bool llama_supports_gpu_offload(void) {
+  return g_api.llama_supports_gpu_offload();
+}
+}  // extern "C"
+#endif  // _WIN32
