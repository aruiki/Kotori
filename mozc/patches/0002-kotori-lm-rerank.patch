+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+//
+// Kotori: llama.cpp の実行時の準備(docs/adr/0016)。
+//
+// Windows では、インストール先に同梱した llama.cpp の公式ビルド(llama.dll、ggml*.dll)を
+// 実行時に読み込む。ggml は GPU(Vulkan)と CPU の種類ごとの DLL から使えるものを自動で選ぶので、
+// ユーザーは CUDA Toolkit などを入れなくてよい。Windows 以外は静的にリンクした CPU 版を使う。
+
+#ifndef MOZC_REWRITER_LLAMA_RUNTIME_H_
+#define MOZC_REWRITER_LLAMA_RUNTIME_H_
+
+#include <string>
+
+namespace mozc {
+
+// llama.cpp を使える状態にする。dir は DLL のあるフォルダ(Windows のみ使う)。
+// 2 回目以降は前の結果を返す。
+bool EnsureLlamaRuntime(const std::string& dir);
+
+// GPU に載せられるか(Vulkan などの GPU が見つかったか)。EnsureLlamaRuntime の後に呼ぶ。
+bool LlamaHasGpu();
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_LLAMA_RUNTIME_H_
