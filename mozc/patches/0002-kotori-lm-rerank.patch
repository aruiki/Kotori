+#include "rewriter/zenz_scorer.h"
+
+namespace mozc {
+
+// 2 段で変換を選ぶ。
+//
+// 1. 文全体: ImmutableConverter が Segments::kotori_sentences() に入れた文全体の候補
+//    (区切りの違う文を含む)に、zenz が読みから生成した文(ビームサーチ)を加え、
+//    zenz と LLM(GPU があるとき)の点数の和で選ぶ。最良の文の区切りで文節を切り直し
+//    (CheckResizeSegmentsRequest。生成した文は全体を 1 文節にする)、Rewrite で
+//    各文節の先頭に置く。
+// 2. 文節ごと: 文全体の結果が使えないとき、上位 K 件を前後の文節とともに zenz で採点する。
+//
+// モデルがなければ何もしない。zenz は KOTORI_ZENZ_MODEL → 品質の段階のモデル → 同梱の
+// zenz-v2.5-small-q8_0.gguf、LLM は設定のパス → KOTORI_LLM_MODEL → 同梱の
+// tinyswallow-1.5b-q5_k_m.gguf(mozc_server と同じフォルダ)。
+//
+// 環境変数(評価と調整用):
+//   KOTORI_ZENZ_MODEL / KOTORI_LLM_MODEL  モデルのパス
+//   KOTORI_MODEL_DIR / KOTORI_RUNTIME_DIR  モデルと llama.cpp の DLL のフォルダ
+//   KOTORI_LM_K          文節ごとに並べ替える候補の数(0 で無効)
+//   KOTORI_LM_BEAMS      zenz で生成する文の数(0 で生成しない)
+//   KOTORI_LM_SENTENCE   0 で文全体の選択を切る
+//   KOTORI_LM_WEIGHTS    "λ_zenz,λ_lattice,T"(既定 "1,1,1000")
+//   KOTORI_LM_LLM_WEIGHT LLM の重み(既定 1)
+//   KOTORI_LM_THREADS    推論のスレッド数(既定 4)
+//   KOTORI_LM_PRECEDING / KOTORI_LM_CONTEXT_MAP  左の文脈を差し替える(評価用)
+class LmRewriter : public RewriterInterface {
+ public:
+  // dictionary は生成した文が読みに合うかを確かめるのに使う(nullptr なら確かめない)。
+  LmRewriter(const dictionary::DictionaryInterface* dictionary,
+             const dictionary::SingleKanjiDictionary* single_kanji);
+
+  int capability(const ConversionRequest& request) const override {
+    return CONVERSION;
+  }
+
+  std::optional<ResizeSegmentsRequest> CheckResizeSegmentsRequest(
+      const ConversionRequest& request,
+      const Segments& segments) const override;
+
+  bool Rewrite(const ConversionRequest& request,
+               Segments* segments) const override;
+
+ private:
+  struct Best {
+    std::string reading;
+    std::string context;
+    std::vector<std::string> keys;
+    std::vector<std::string> values;
+  };
+
+  // 設定に合わせてモデルを用意する。zenz を返し(使えなければ nullptr)、*llm に LLM
+  // (使わないなら nullptr)、*k に文節ごとの候補数、*beams に生成する文の数を入れる。
+  ZenzScorer* Prepare(const ConversionRequest& request, size_t* k,
+                      ZenzScorer** llm, int* beams) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  void EnsureLoaded(const std::string& path) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  void EnsureLlmLoaded(const std::string& path) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  bool ApplyBest(Segments* segments, const std::string& context) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  bool RewriteEachSegment(const ConversionRequest& request,
+                          ZenzScorer* scorer, size_t k,
+                          Segments* segments) const;
+  double Combine(float logp, int cost) const {
+    return lambda_lm_ * logp - lambda_lattice_ * cost / temperature_;
+  }
+
+  const dictionary::DictionaryInterface* dictionary_;
+  const dictionary::SingleKanjiDictionary* single_kanji_;
+  mutable absl::Mutex mutex_;
+  mutable std::string loaded_path_ ABSL_GUARDED_BY(mutex_);
+  mutable bool loaded_ ABSL_GUARDED_BY(mutex_) = false;
+  mutable std::unique_ptr<ZenzScorer> scorer_ ABSL_GUARDED_BY(mutex_);
+  mutable std::string llm_path_ ABSL_GUARDED_BY(mutex_);
+  mutable bool llm_loaded_ ABSL_GUARDED_BY(mutex_) = false;
+  mutable std::unique_ptr<ZenzScorer> llm_ ABSL_GUARDED_BY(mutex_);
+  mutable std::optional<Best> best_ ABSL_GUARDED_BY(mutex_);
+  std::optional<size_t> k_override_;
+  std::optional<int> beams_override_;
+  // 文全体の選択に入れる、ラティスの文全体の候補の数(KOTORI_LM_NSENT)。
+  size_t max_sentences_ = 4;
+  bool sentence_ = true;
+  bool post_segment_ = false;
+  bool right_context_ = true;
+  double lambda_lm_ = 1.0;
+  double lambda_llm_ = 1.0;
+  double lambda_lattice_ = 1.0;
+  double temperature_ = 1000.0;
+  int threads_ = 4;
+  std::string env_model_path_;
+  std::string env_llm_path_;
+  std::string model_dir_;
+  std::string runtime_dir_;
+};
