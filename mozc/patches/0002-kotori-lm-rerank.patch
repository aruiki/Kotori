+namespace mozc {
+
+class ZenzScorer {
+ public:
+  // GGUF を読み込む。失敗したら nullptr。
+  // runtime_dir は llama.cpp の DLL のあるフォルダ(Windows のみ使う)。
+  static std::unique_ptr<ZenzScorer> Open(const std::string& path, int threads,
+                                          const std::string& runtime_dir);
+  ~ZenzScorer();
+
+  // このスレッドの生成(Generate・Continue)を、1 トークンごとに途中でやめるかを返す関数。
+  // 裏の予測で使い、変換の要求が来たらすぐ GPU を譲る。空の関数なら止めない。
+  static void SetThreadCancel(std::function<bool()> cancel);
+
+  // 候補ごとの log P(候補 </s> | 読みと左文脈)。失敗したら nullopt。
+  std::optional<std::vector<float>> Score(
+      absl::string_view left_context, absl::string_view reading,
+      const std::vector<std::string>& candidates);
+
+  // zenz で読みから文を生成する(ビームサーチ)。よい順に最大 beams 件。zenz でなければ空。
+  std::vector<std::string> Generate(absl::string_view left_context,
+                                    absl::string_view reading, int beams);
+
+  // 複数の読みを 1 回のビームサーチでまとめて生成する(GPU を呼ぶ回数を減らすため)。
+  // 結果は読みごと。
+  std::vector<std::vector<std::string>> GenerateMany(
+      absl::string_view left_context, const std::vector<std::string>& readings,
+      int beams);
+
+  // 汎用の LLM で text の続きを生成する(ビームサーチ、句読点や改行の手前まで)。
+  // よい順に最大 beams 件。zenz なら空。
+  std::vector<std::string> Continue(absl::string_view text, int max_tokens,
+                                    int beams);
+
+  // 複数の text(と、それぞれのビームの数)の続きを 1 回のビームサーチでまとめて作る。
+  std::vector<std::vector<std::string>> ContinueMany(
+      const std::vector<std::pair<std::string, int>>& texts, int max_tokens);
+
+  // text のトークン数。
+  size_t CountTokens(absl::string_view text);
+
+  bool is_zenz() const { return zenz_; }
+
+  // 計算量の累計(評価用、KOTORI_LM_STATS)。zenz と LLM ごとの、Score・生成の時間、
+  // その中の llama_decode の時間、decode の回数と評価したトークン数。
+  static std::string Stats();
+
+  // zenz のプロンプト。U+EE00 読み(カタカナ) U+EE02 左文脈 U+EE01。
+  static std::string Prompt(absl::string_view left_context,
+                            absl::string_view reading);
+
+ private:
+  ZenzScorer() = default;
+  // ビームサーチの根。prefix に続くトークン列を、最大 max_len トークン、beams 本で作る。
+  struct Root {
+    std::vector<llama_token> prefix;
+    int max_len;
+    int beams;
+  };
+  // 根ごとに、prefix に続くトークン列をビームサーチで作る(すべての根を 1 ステップごとに
+  // 1 つのバッチで評価する)。is_end が真のトークンで終わる(そのトークンは含めない)。
+  // finish_at_max なら長さの上限に達したものも結果に入れる。
+  std::vector<std::vector<std::vector<llama_token>>> BeamSearch(
+      const std::vector<Root>& roots,
+      const std::function<bool(llama_token)>& is_end, bool finish_at_max);
+  // シーケンス 0 に prefix の最後の 1 トークンより前を置き、ほかのシーケンスを空にする。
+  // 前回と同じ先頭は計算し直さない(同じ前の文・読みでの採点や生成が続くため)。
+  bool UsePrefix(const std::vector<llama_token>& prefix);
+  // 計算の後、シーケンス 0 の prefix の最後の 1 トークンより前だけを残す。
+  void KeepPrefix(const std::vector<llama_token>& prefix);
+  // KV をすべて消す。
+  void ResetMemory();
+  std::string Detokenize(const std::vector<llama_token>& tokens);
+  llama_model* model_ = nullptr;
+  llama_context* ctx_ = nullptr;
+  int max_seq_ = 0;
+  // zenz(読みを入れたプロンプト)か、汎用の LLM(左の文脈だけ)か。
+  bool zenz_ = true;
+  // シーケンス 0 に残っている前置きのトークン(UsePrefix)。
+  std::vector<llama_token> cached_;
+};
+
+}  // namespace mozc
