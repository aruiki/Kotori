+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/zenz_scorer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+#include "llama.h"
+#include "rewriter/llama_runtime.h"
+
+namespace mozc {
+namespace {
+
+constexpr uint32_t kNumContext = 4096;
+constexpr int kMaxCandidates = 32;
+constexpr size_t kMaxContextChars = 40;
+
+// UTF-8 の文字列を文字(コードポイント)ごとの文字列にする。
+std::vector<std::string> SplitChars(absl::string_view s) {
+  std::vector<std::string> out;
+  for (size_t i = 0; i < s.size();) {
+    const unsigned char c = s[i];
+    size_t n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+    n = std::min(n, s.size() - i);
+    out.emplace_back(s.substr(i, n));
+    i += n;
+  }
+  return out;
+}
+
+// 改行を落とし、空白を全角空白にする(Zenzai と同じ)。
+std::string Normalize(absl::string_view text) {
+  std::string out;
+  for (const std::string& c : SplitChars(text)) {
+    if (c == "\n" || c == "\r") continue;
+    out += (c == " ") ? "\xE3\x80\x80" : c;
+  }
+  return out;
+}
+
+// ひらがな(U+3041..U+3096)をカタカナにする。
+std::string ToKatakana(absl::string_view reading) {
+  std::string out;
+  for (const std::string& c : SplitChars(reading)) {
+    if (c.size() == 3 && static_cast<unsigned char>(c[0]) == 0xE3) {
+      const uint32_t cp =
+          ((c[0] & 0x0F) << 12) | ((c[1] & 0x3F) << 6) | (c[2] & 0x3F);
+      if (cp >= 0x3041 && cp <= 0x3096) {
+        const uint32_t k = cp + 0x60;
+        out += static_cast<char>(0xE0 | (k >> 12));
+        out += static_cast<char>(0x80 | ((k >> 6) & 0x3F));
+        out += static_cast<char>(0x80 | (k & 0x3F));
+        continue;
+      }
+    }
+    out += c;
+  }
+  return out;
+}
+
+std::vector<llama_token> Tokenize(const llama_vocab* vocab,
+                                  const std::string& text) {
+  std::vector<llama_token> tokens(text.size() + 8);
+  int n = llama_tokenize(vocab, text.data(), text.size(), tokens.data(),
+                         tokens.size(), false, false);
+  if (n < 0) {
+    tokens.resize(-n);
+    n = llama_tokenize(vocab, text.data(), text.size(), tokens.data(),
+                       tokens.size(), false, false);
+  }
+  tokens.resize(std::max(n, 0));
+  return tokens;
+}
+
+std::vector<float> LogSoftmax(const float* logits, int n) {
+  float max = -std::numeric_limits<float>::infinity();
+  for (int i = 0; i < n; ++i) max = std::max(max, logits[i]);
+  double sum = 0;
+  for (int i = 0; i < n; ++i) sum += std::exp(logits[i] - max);
+  const float lse = max + static_cast<float>(std::log(sum));
+  std::vector<float> out(n);
+  for (int i = 0; i < n; ++i) out[i] = logits[i] - lse;
+  return out;
+}
+
+}  // namespace
+
+std::string ZenzScorer::Prompt(absl::string_view left_context,
+                               absl::string_view reading) {
+  std::vector<std::string> ctx = SplitChars(Normalize(left_context));
+  if (ctx.size() > kMaxContextChars) {
+    ctx.erase(ctx.begin(), ctx.end() - kMaxContextChars);
+  }
+  std::string out = "\xEE\xB8\x80";  // U+EE00
+  out += Normalize(ToKatakana(reading));
+  if (!ctx.empty()) {
+    out += "\xEE\xB8\x82";  // U+EE02
+    for (const std::string& c : ctx) out += c;
+  }
+  out += "\xEE\xB8\x81";  // U+EE01
+  return out;
+}
+
+std::unique_ptr<ZenzScorer> ZenzScorer::Open(const std::string& path,
+                                             int threads,
+                                             const std::string& runtime_dir) {
+  if (!EnsureLlamaRuntime(runtime_dir)) return nullptr;
+  llama_model_params mp = llama_model_default_params();
+  // GPU があれば全部の層を載せる(なければ CPU で動く)。
+  mp.n_gpu_layers = LlamaHasGpu() ? 999 : 0;
+  llama_model* model = llama_model_load_from_file(path.c_str(), mp);
+  if (model == nullptr) return nullptr;
+  llama_context_params cp = llama_context_default_params();
+  cp.n_ctx = kNumContext;
+  cp.n_batch = kNumContext;
+  cp.n_ubatch = kNumContext;
+  cp.n_seq_max = kMaxCandidates + 1;
+  cp.n_threads = threads;
+  cp.n_threads_batch = threads;
+  cp.kv_unified = true;
+  llama_context* ctx = llama_init_from_model(model, cp);
+  if (ctx == nullptr) {
+    llama_model_free(model);
+    return nullptr;
+  }
+  std::unique_ptr<ZenzScorer> s(new ZenzScorer());
+  s->model_ = model;
+  s->ctx_ = ctx;
+  s->max_seq_ = kMaxCandidates;
+  // zenz は 1 文字ずつの小さな語彙(6000)を持つ。汎用の LLM(語彙が数万以上)なら、
+  // 読みを使わず log P(候補 | 左の文脈) で採点する(docs/adr/0016)。
+  s->zenz_ = llama_vocab_n_tokens(llama_model_get_vocab(model)) <= 16000;
+  return s;
+}
+
+ZenzScorer::~ZenzScorer() {
+  if (ctx_ != nullptr) llama_free(ctx_);
+  if (model_ != nullptr) llama_model_free(model_);
+}
+
+std::optional<std::vector<float>> ZenzScorer::Score(
+    absl::string_view left_context, absl::string_view reading,
+    const std::vector<std::string>& candidates) {
+  if (candidates.empty() ||
+      candidates.size() > static_cast<size_t>(max_seq_)) {
+    return std::nullopt;
+  }
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const int n_vocab = llama_vocab_n_tokens(vocab);
+  const llama_token eos = llama_vocab_eos(vocab);
+  std::vector<llama_token> prefix;
+  if (zenz_) {
+    prefix = Tokenize(vocab, Prompt(left_context, reading));
+  } else {
+    // 先頭のトークンを足すのは、モデルが付けるよう求めるときだけ(Qwen 系は付けない)。
+    const llama_token bos = llama_vocab_bos(vocab);
+    if (bos >= 0 && llama_vocab_get_add_bos(vocab)) prefix.push_back(bos);
+    std::string ctx(left_context);
+    if (ctx.empty() && prefix.empty()) ctx = "\n";
+    const std::vector<llama_token> t = Tokenize(vocab, ctx);
+    prefix.insert(prefix.end(), t.begin(), t.end());
+  }
+  if (prefix.empty()) return std::nullopt;
+  std::vector<std::vector<llama_token>> cands;
+  size_t total = prefix.size();
+  for (const std::string& c : candidates) {
+    if (zenz_) {
+      cands.push_back(Tokenize(vocab, Normalize(c)));
+      cands.back().push_back(eos);
+    } else {
+      cands.push_back(Tokenize(vocab, c));
+    }
+    if (cands.back().empty()) return std::nullopt;
+    total += cands.back().size();
+  }
+  if (total > kNumContext) return std::nullopt;
+  if (std::getenv("KOTORI_LM_DEBUG") != nullptr) {
+    std::fprintf(stderr, "[zenz] n_vocab=%d prefix:", n_vocab);
+    for (llama_token t : prefix) std::fprintf(stderr, " %d", t);
+    std::fprintf(stderr, " | cand0:");
+    for (llama_token t : cands[0]) std::fprintf(stderr, " %d", t);
+    std::fprintf(stderr, "\n");
+  }
+
+  llama_memory_t mem = llama_get_memory(ctx_);
+  llama_memory_clear(mem, true);
+
+  // 前置きをシーケンス 0 で評価し、最後の位置のロジットだけを受け取る。
+  {
+    llama_batch b = llama_batch_init(prefix.size(), 0, 1);
+    for (size_t i = 0; i < prefix.size(); ++i) {
+      b.token[i] = prefix[i];
+      b.pos[i] = i;
+      b.n_seq_id[i] = 1;
+      b.seq_id[i][0] = 0;
+      b.logits[i] = i + 1 == prefix.size();
+    }
+    b.n_tokens = prefix.size();
+    const int rc = llama_decode(ctx_, b);
+    llama_batch_free(b);
+    if (rc != 0) return std::nullopt;
+  }
+  const std::vector<float> first =
+      LogSoftmax(llama_get_logits_ith(ctx_, prefix.size() - 1), n_vocab);
+  for (size_t s = 0; s < cands.size(); ++s) {
+    llama_memory_seq_cp(mem, 0, s + 1, -1, -1);
+  }
+
+  // 候補のトークンを1つのバッチで評価する(最後のトークンの次は要らない)。
+  size_t n_tok = 0;
+  for (const auto& c : cands) n_tok += c.size();
+  llama_batch b = llama_batch_init(n_tok, 0, 1);
+  std::vector<std::vector<int>> index(cands.size());
+  int at = 0;
+  for (size_t s = 0; s < cands.size(); ++s) {
+    for (size_t j = 0; j < cands[s].size(); ++j, ++at) {
+      b.token[at] = cands[s][j];
+      b.pos[at] = prefix.size() + j;
+      b.n_seq_id[at] = 1;
+      b.seq_id[at][0] = s + 1;
+      b.logits[at] = j + 1 < cands[s].size();
+      index[s].push_back(at);
+    }
+  }
+  b.n_tokens = n_tok;
+  const int rc = llama_decode(ctx_, b);
+  llama_batch_free(b);
+  std::optional<std::vector<float>> result;
+  if (rc == 0) {
+    std::vector<float> scores;
+    for (size_t s = 0; s < cands.size(); ++s) {
+      float logp = 0;
+      for (size_t j = 0; j < cands[s].size(); ++j) {
+        const std::vector<float> table =
+            j == 0 ? first
+                   : LogSoftmax(llama_get_logits_ith(ctx_, index[s][j - 1]),
+                                n_vocab);
+        logp += table[cands[s][j]];
+      }
+      scores.push_back(logp);
+    }
+    result = std::move(scores);
+  }
+  llama_memory_clear(mem, true);
+  return result;
+}
+
+std::vector<std::string> ZenzScorer::Generate(absl::string_view left_context,
+                                              absl::string_view reading,
+                                              int beams) {
+  std::vector<std::string> out;
+  if (!zenz_ || beams < 1 || 2 * beams + 1 > max_seq_) return out;
+  const llama_vocab* vocab = llama_model_get_vocab(model_);
+  const int n_vocab = llama_vocab_n_tokens(vocab);
+  const llama_token eos = llama_vocab_eos(vocab);
+  const std::vector<llama_token> prefix =
+      Tokenize(vocab, Prompt(left_context, reading));
+  const int max_len = static_cast<int>(SplitChars(reading).size()) + 8;
+  if (prefix.empty() || prefix.size() + max_len + 1 > kNumContext) return out;
+
+  llama_memory_t mem = llama_get_memory(ctx_);
+  llama_memory_clear(mem, true);
+  {
+    llama_batch b = llama_batch_init(prefix.size(), 0, 1);
+    for (size_t i = 0; i < prefix.size(); ++i) {
+      b.token[i] = prefix[i];
+      b.pos[i] = i;
+      b.n_seq_id[i] = 1;
+      b.seq_id[i][0] = 0;
+      b.logits[i] = i + 1 == prefix.size();
+    }
+    b.n_tokens = prefix.size();
+    const int rc = llama_decode(ctx_, b);
+    llama_batch_free(b);
+    if (rc != 0) {
+      llama_memory_clear(mem, true);
+      return out;
+    }
+  }
+
+  // ビームサーチ。シーケンス 1..beams と beams+1..2*beams を交互に使い、親の KV を写してから
+  // 次のトークンを評価する。logits は各ビームの直前のトークンの位置のもの。
+  struct Beam {
+    std::vector<llama_token> tokens;
+    float logp = 0;
+    int seq = 0;
+    int logit_index = 0;  // 直前の decode での位置(最初は前置きの最後)
+  };
+  std::vector<Beam> live = {{{}, 0.f, 0, static_cast<int>(prefix.size()) - 1}};
+  std::vector<std::pair<float, std::vector<llama_token>>> done;
+  int base = 1;
+  for (int step = 0; step < max_len && !live.empty(); ++step) {
+    struct Next {
+      float logp;
+      size_t parent;
+      llama_token token;
+    };
+    std::vector<Next> next;
+    for (size_t p = 0; p < live.size(); ++p) {
+      const std::vector<float> table =
+          LogSoftmax(llama_get_logits_ith(ctx_, live[p].logit_index), n_vocab);
+      std::vector<int> idx(n_vocab);
+      for (int i = 0; i < n_vocab; ++i) idx[i] = i;
+      std::partial_sort(idx.begin(), idx.begin() + beams, idx.end(),
+                        [&](int a, int b) { return table[a] > table[b]; });
+      for (int j = 0; j < beams; ++j) {
+        next.push_back({live[p].logp + table[idx[j]], p, idx[j]});
+      }
+    }
+    std::sort(next.begin(), next.end(),
+              [](const Next& a, const Next& b) { return a.logp > b.logp; });
+    std::vector<Beam> grown;
+    for (const Next& n : next) {
+      if (static_cast<int>(grown.size()) + static_cast<int>(done.size()) >=
+          beams) {
+        break;
+      }
+      std::vector<llama_token> t = live[n.parent].tokens;
+      if (n.token == eos) {
+        if (!t.empty()) done.push_back({n.logp / (t.size() + 1), t});
+        continue;
+      }
+      t.push_back(n.token);
+      grown.push_back({std::move(t), n.logp, 0, 0});
+    }
+    if (grown.empty()) break;
+    // 親の KV を新しいシーケンスに写し、新しいトークンを 1 つのバッチで評価する。
+    llama_batch b = llama_batch_init(grown.size(), 0, 1);
+    for (size_t i = 0; i < grown.size(); ++i) {
+      const int seq = base + static_cast<int>(i);
+      llama_memory_seq_rm(mem, seq, -1, -1);
+      // grown[i] の親は、トークン列の最後を除いたもの。
+      int parent_seq = 0;
+      for (const Beam& lb : live) {
+        if (lb.tokens.size() + 1 == grown[i].tokens.size() &&
+            std::equal(lb.tokens.begin(), lb.tokens.end(),
+                       grown[i].tokens.begin())) {
+          parent_seq = lb.seq;
+          break;
+        }
+      }
+      llama_memory_seq_cp(mem, parent_seq, seq, -1, -1);
+      grown[i].seq = seq;
+      grown[i].logit_index = static_cast<int>(i);
+      b.token[i] = grown[i].tokens.back();
+      b.pos[i] = prefix.size() + grown[i].tokens.size() - 1;
+      b.n_seq_id[i] = 1;
+      b.seq_id[i][0] = seq;
+      b.logits[i] = 1;
+    }
+    b.n_tokens = grown.size();
+    const int rc = llama_decode(ctx_, b);
+    llama_batch_free(b);
+    if (rc != 0) break;
+    // 使い終わった親のシーケンスを消す(前置きのシーケンス 0 は残す)。
+    for (const Beam& lb : live) {
+      if (lb.seq != 0) llama_memory_seq_rm(mem, lb.seq, -1, -1);
+    }
+    live = std::move(grown);
+    base = base == 1 ? beams + 1 : 1;
+  }
+  llama_memory_clear(mem, true);
+
+  std::sort(done.begin(), done.end(),
+            [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (const auto& [score, tokens] : done) {
+    std::string text;
+    for (llama_token t : tokens) {
+      char buf[64];
+      const int n = llama_token_to_piece(vocab, t, buf, sizeof(buf), 0, false);
+      if (n > 0) text.append(buf, n);
+    }
+    // zenz は空白を全角空白で学習している。候補の表記は元の空白に戻す。
+    for (size_t pos; (pos = text.find("\xE3\x80\x80")) != std::string::npos;) {
+      text.replace(pos, 3, " ");
+    }
+    if (!text.empty() &&
+        std::find(out.begin(), out.end(), text) == out.end()) {
+      out.push_back(text);
+    }
+  }
+  return out;
+}
+
+}  // namespace mozc
