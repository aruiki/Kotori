+}  // namespace
+
+std::vector<LmRewriter::Prediction> LmRewriter::ComputePredictions(
+    const config::Config& config, const std::string& reading,
+    const std::string& context, std::string* conv_out, bool background,
+    bool light, std::chrono::steady_clock::time_point deadline) const {
+  std::vector<Prediction> preds;
+  size_t k = 0, llm_top = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = PrepareFor(config, &k, &llm, &beams, &llm_top, true,
+                                  background || sync_load_);
+  if (scorer == nullptr || llm == nullptr) return preds;
+  // 裏で計算しているときは、変換の要求が来たらすぐやめる。light なら打鍵に間に合うよう
+  // 軽くする(続きは 2 件・6 トークン、辞書の語を試す段は省く)。重い計算(作り直し)は
+  // 次の打鍵が来てもやめる。軽い計算は最後までして、次の打鍵の候補に使う。
+  const bool timed = deadline != std::chrono::steady_clock::time_point::max();
+  auto yield = [&] {
+    if (timed && std::chrono::steady_clock::now() > deadline) return true;
+    return background && (urgent_.load() > 0 || stop_.load() ||
+                          (!light && new_job_.load()));
+  };
+  // 生成の途中(1 トークンごと)でもやめられるようにする。
+  CancelScope cancel_scope(background || timed ? std::function<bool()>(yield)
+                                               : std::function<bool()>());
+  const int mode = light ? (predict_mode_ & 3) : predict_mode_;
+  const int n_beams = light ? light_beams_ : predict_beams_;
+  // 打ちかけを除いた変換の続きの数。GPU(Vulkan)は 1 回に 3 トークン以上を渡すと 2 トークンの
+  // 2 倍ほどかかるので、軽い計算では 2 つの続きの合計を小さくする(docs/adr/0024)。
+  const int n_head_beams = light ? light_head_beams_ : predict_beams_ + 1;
+  const int n_tokens =
+      light ? std::min(predict_tokens_, light_tokens_) : predict_tokens_;
+  const std::vector<std::string> rchars = Chars(reading);
+  // 変換する読み: 読み全体と、最後の 1〜2 文字を打ちかけとみなして除いた読み(heads)。
+  const size_t max_drop = light ? 1 : 2;
+  std::vector<std::string> heads, rests;
+  for (size_t drop = 1; drop <= max_drop && rchars.size() >= drop + 2; ++drop) {
+    std::string head, rest;
+    for (size_t i = 0; i < rchars.size(); ++i) {
+      (i + drop < rchars.size() ? head : rest) += rchars[i];
+    }
+    heads.push_back(std::move(head));
+    rests.push_back(std::move(rest));
+  }
+  // zenz の変換は、すべての読みを 1 回のビームサーチでまとめて行う(GPU を呼ぶ回数を減らす。
+  // docs/adr/0024)。convs[0] が読み全体、convs[i + 1] が heads[i] の変換。
+  std::vector<std::string> to_convert = {reading};
+  to_convert.insert(to_convert.end(), heads.begin(), heads.end());
+  const auto tt0 = std::chrono::steady_clock::now();
+  const std::vector<std::vector<std::string>> gens =
+      scorer->GenerateMany(context, to_convert, 2);
+  std::vector<std::string> convs(to_convert.size());
+  for (size_t i = 0; i < gens.size() && i < convs.size(); ++i) {
+    for (const std::string& g : gens[i]) {
+      if (dictionary_ == nullptr ||
+          MatchesReading(*dictionary_, single_kanji_, g, to_convert[i])) {
+        convs[i] = g;
+        break;
+      }
+    }
+  }
+  const std::string conv = convs[0];
+  const auto tt1 = std::chrono::steady_clock::now();
+  if (conv_out != nullptr) *conv_out = conv;
+  if (conv.empty() || yield()) return preds;
+  auto add = [&](const std::string& text, const std::string& base,
+                 const std::string& covered) {
+    if (text == conv || HasDigit(text)) return;
+    const absl::string_view continuation =
+        absl::string_view(text).substr(std::min(base.size(), text.size()));
+    if (filter_junk_ && IsJunkPrediction(text, continuation, reading)) return;
+    // 続きが 1 文字以下(「かしこま」+「ら」)は、語の途中で切れていることが多く、打つ手間も減らない。
+    if (min_continuation_chars_ > 0 &&
+        Util::CharsLen(continuation) < static_cast<size_t>(min_continuation_chars_)) {
+      return;
+    }
+    for (const Prediction& p : preds) {
+      if (p.text == text) return;
+    }
+    preds.push_back({text, base, covered, std::string()});
+  };
+  // 1. 読み全体の変換に、LLM で続きを付ける。
+  // 2. 最後の 1〜2 文字が打ちかけの場合(「おせわに」→「お世話」+「になっております」、
+  //    「きょうはいいて」→「今日はいい」+「天気」)。打ちかけを除いた変換に続きを付ける。
+  // 1 と 2 は 1 回のビームサーチでまとめて作る。
+  std::vector<std::pair<std::string, int>> roots;
+  std::vector<int> root_head;  // -1 なら読み全体、i なら heads[i]
+  if ((mode & 1) && n_beams > 0) {
+    roots.push_back({Tail(context) + conv, n_beams});
+    root_head.push_back(-1);
+  }
+  if ((mode & 2) && dictionary_ != nullptr && n_head_beams > 0) {
+    for (size_t i = 0; i < heads.size(); ++i) {
+      if (convs[i + 1].empty()) continue;
+      roots.push_back({Tail(context) + convs[i + 1], n_head_beams});
+      root_head.push_back(static_cast<int>(i));
+    }
+  }
+  const std::vector<std::vector<std::string>> conts =
+      llm->ContinueMany(roots, n_tokens);
+  for (size_t r = 0; r < conts.size(); ++r) {
+    if (root_head[r] < 0) {
+      for (const std::string& c : conts[r]) {
+        if (NaturalStart(c)) add(conv + c, conv, reading);
+      }
+      continue;
+    }
+    const size_t i = root_head[r];
+    const std::string& base = convs[i + 1];
+    for (const std::string& c : conts[r]) {
+      if (NaturalStart(c) &&
+          (light ||
+           MatchesReading(*dictionary_, single_kanji_, c, rests[i], true))) {
+        add(base + c, base, heads[i]);
+      }
+    }
+  }
+  std::vector<std::pair<std::string, std::string>> partial;  // (文, 土台)
+  std::vector<std::string> partial_covered;
+  for (size_t i = 0; i < heads.size() && (mode & 4); ++i) {
+    if (yield()) return preds;
+    const std::string& base = convs[i + 1];
+    if (base.empty() || dictionary_ == nullptr) continue;
+    const std::string& head = heads[i];
+    const std::string& rest = rests[i];
+    // その読みで始まる語を辞書から出やすい順に取り、LLM が文脈に合うものを選ぶ。
+    PredictiveCollector pc;
+    dictionary_->LookupPredictive(rest, &pc);
+    std::vector<std::pair<int, std::string>> words;
+    for (auto& [key, value, cost] : pc.tokens) {
+      if (Util::CharsLen(key) > Util::CharsLen(rest)) {
+        words.emplace_back(cost, value);
+      }
+    }
+    std::sort(words.begin(), words.end());
+    size_t taken = 0;
+    for (const auto& [cost, w] : words) {
+      const std::string v = base + w;
+      bool dup = false;
+      for (const auto& pp : partial) dup = dup || pp.first == v;
+      if (dup) continue;
+      partial.emplace_back(v, base);
+      partial_covered.push_back(head);
+      if (++taken >= 12) break;
+    }
+  }
+  if (!partial.empty() && !yield()) {
+    std::vector<std::string> texts;
+    for (const auto& pp : partial) texts.push_back(pp.first);
+    if (auto logp = llm->Score(context, reading, texts)) {
+      std::vector<size_t> order(texts.size());
+      std::iota(order.begin(), order.end(), 0);
+      std::stable_sort(order.begin(), order.end(), [&](size_t x, size_t y) {
+        return (*logp)[x] / Util::CharsLen(texts[x]) >
+               (*logp)[y] / Util::CharsLen(texts[y]);
+      });
+      for (size_t n = 0; n < std::min<size_t>(2, order.size()); ++n) {
+        const size_t i = order[n];
+        add(texts[i], partial[i].second, partial_covered[i]);
+        // いちばんよいものには、さらに続きを付ける。
+        if (n == 0 && !yield()) {
+          for (const std::string& c :
+               llm->Continue(Tail(context) + texts[i], predict_tokens_, 2)) {
+            if (NaturalStart(c)) {
+              add(texts[i] + c, partial[i].second, partial_covered[i]);
+            }
+          }
+        }
+      }
+    }
+  }
+  // 3. 前の文のもとでの自然さ(1 トークンあたりの log P)で並べる。軽い計算では省ける
+  //    (KOTORI_LM_LIGHT_RANK=0。続きのビームサーチの順のまま。docs/adr/0024)。
+  if (preds.size() >= 2 && (!light || light_rank_) && !yield()) {
+    std::vector<std::string> texts;
+    for (const Prediction& p : preds) texts.push_back(p.text);
+    if (auto logp = llm->Score(context, reading, texts)) {
+      std::vector<double> avg(preds.size());
+      for (size_t i = 0; i < preds.size(); ++i) {
+        avg[i] = (*logp)[i] / std::max<size_t>(1, llm->CountTokens(texts[i]));
+      }
+      std::vector<size_t> order(preds.size());
+      std::iota(order.begin(), order.end(), 0);
+      std::stable_sort(order.begin(), order.end(),
+                       [&](size_t x, size_t y) { return avg[x] > avg[y]; });
+      std::vector<Prediction> sorted;
+      for (size_t i : order) sorted.push_back(preds[i]);
+      preds = std::move(sorted);
+    }
+  }
+  const auto tt2 = std::chrono::steady_clock::now();
+  // 上位の予測は、続きの読みを求めておく(打鍵ごとの確認を速くするため)。
+  if (dictionary_ != nullptr) {
+    const size_t n = light ? 3 : 6;
+    for (size_t i = 0; i < preds.size() && i < n && !yield(); ++i) {
+      const std::string cont = preds[i].text.substr(preds[i].base.size());
+      const std::string y = ReadingOf(*dictionary_, single_kanji_, cont);
+      if (!y.empty()) preds[i].yomi = preds[i].covered + y;
+    }
+    if (light) {
+      // 軽い計算では、読みが求まって今の読みで始まるものだけを残す。
+      std::vector<Prediction> kept;
+      for (Prediction& p : preds) {
+        if (!p.yomi.empty() && absl::StartsWith(p.yomi, reading)) {
+          kept.push_back(std::move(p));
+        }
+      }
+      preds = std::move(kept);
+    }
+  }
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    auto ms = [](auto a, auto z) {
+      return std::chrono::duration<double, std::milli>(z - a).count();
+    };
+    std::fprintf(stderr, "[ptime] %s conv=%.0f gen+rank=%.0f yomi=%.0f\n",
+                 light ? "bg" : background ? "bg-full" : "fg", ms(tt0, tt1),
+                 ms(tt1, tt2),
+                 ms(tt2, std::chrono::steady_clock::now()));
+  }
+  return preds;
+}
+
+bool LmRewriter::PredictionFits(const Prediction& p,
+                                const std::string& reading) const {
+  if (!absl::StartsWith(reading, p.covered) ||
+      !absl::StartsWith(p.text, p.base)) {
+    return false;
+  }
+  const std::string needed = reading.substr(p.covered.size());
+  if (needed.empty()) return true;
+  // 読みを求めてあれば文字列の比較だけで決める(打鍵ごとに辞書を引かない)。
+  return !p.yomi.empty() && absl::StartsWith(p.yomi, reading);
+}
+
+void LmRewriter::InsertPredictions(Segment* seg, const std::string& reading,
+                                   const std::vector<std::string>& texts,
+                                   const std::vector<bool>& from_ai) const {
+  converter::Candidate base;
+  if (seg->candidates_size() > 0) base = seg->candidate(0);
+  for (size_t i = 0; i < texts.size(); ++i) {
+    std::optional<converter::Candidate> existing;
+    for (size_t j = 0; j < seg->candidates_size(); ++j) {
+      if (seg->candidate(j).value == texts[i]) {
+        existing = seg->candidate(j);
+        seg->erase_candidate(j);
+        break;
+      }
+    }
+    converter::Candidate c = existing.value_or(base);
+    if (!existing) {
+      c.key = reading;
+      c.content_key = reading;
+      c.value = texts[i];
+      c.content_value = texts[i];
+      c.consumed_key_size = Util::CharsLen(reading);
+      c.inner_segment_boundary.clear();
+      c.prefix.clear();
+      c.suffix.clear();
+    }
+    if (from_ai[i] && !existing) c.description = "AI";
+    *seg->insert_candidate(static_cast<int>(i)) = std::move(c);
+  }
+}
+
+bool LmRewriter::RewritePrediction(const ConversionRequest& request,
+                                   Segments* segments) const {
+  if (!predict_ || segments->conversion_segments_size() != 1) return false;
+  if (!request.config().kotori_lm_predict()) return false;
+  // シークレットモードでは AI の予測を作らず、覚えておいた予測も使わない。
+  if (request.incognito_mode()) return false;
+  Segment& seg = *segments->mutable_conversion_segment(0);
+  const std::string reading(seg.key());
+  const size_t len = Util::CharsLen(reading);
+  if (len < 2 || len > kMaxPredictChars) return false;
+  const auto t0 = std::chrono::steady_clock::now();
+  const std::string context = HistoryContext(request, *segments);
+  const std::string key = CacheKey(request.config(), context);
+  std::string conv;
+  // 入力中の候補のために裏で計算した予測があれば使う(Tab を待たせない)。なければ計算する。
+  // その場の計算には時間の上限を設け、超えたら Mozc の予測だけを出す(案 03)。
+  std::vector<Prediction> preds = CachedPredictions(reading, key, 6);
+  const bool from_cache = !preds.empty();
+  if (!from_cache) {
+    const auto deadline = tab_budget_ms_ > 0
+                              ? t0 + std::chrono::milliseconds(tab_budget_ms_)
+                              : std::chrono::steady_clock::time_point::max();
+    preds = ComputePredictions(request.config(), reading, context, &conv, false,
+                               false, deadline);
+    if (tab_budget_ms_ > 0 && std::chrono::steady_clock::now() > deadline) {
+      return false;  // 途中でやめた予測は出さず、覚えない
+    }
+    StorePredictions(reading, key, preds);
+  }
+  size_t k = 0, llm_top = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  PrepareFor(request.config(), &k, &llm, &beams, &llm_top, true, sync_load_);
+  if (llm == nullptr) return false;
+  // Mozc 自身の予測候補(上位 8 件)と読みの変換も加え、1 トークンあたりの log P で並べる。
+  std::vector<std::string> pool;
+  std::vector<bool> from_ai;
+  for (const Prediction& p : preds) {
+    pool.push_back(p.text);
+    from_ai.push_back(true);
+  }
+  for (size_t j = 0; j < seg.candidates_size() && j < 8; ++j) {
+    const std::string& v = seg.candidate(j).value;
+    if (std::find(pool.begin(), pool.end(), v) == pool.end()) {
+      pool.push_back(v);
+      from_ai.push_back(false);
+    }
+  }
+  if (!conv.empty() && std::find(pool.begin(), pool.end(), conv) == pool.end()) {
+    pool.push_back(conv);
+    from_ai.push_back(true);
+  }
+  std::vector<std::string> ranked;
+  std::vector<bool> ranked_ai;
+  if (auto logp = llm->Score(context, reading, pool)) {
+    std::vector<size_t> order;
+    std::vector<double> avg(pool.size());
+    for (size_t i = 0; i < pool.size(); ++i) {
+      if (HasDigit(pool[i]) && !HasDigit(reading)) continue;
+      // 先頭に並べる枠には、ゴミ(IsJunkPrediction)と、読みのまま変換されていないものを入れない。
+      // Mozc の候補なら、先頭に出さないだけで、Mozc の候補の一覧には元の位置で残る。
+      if (filter_junk_ &&
+          (pool[i] == reading || IsJunkPrediction(pool[i], "", reading))) {
+        continue;
+      }
+      avg[i] = (*logp)[i] / std::max<size_t>(1, llm->CountTokens(pool[i]));
+      order.push_back(i);
+    }
+    std::stable_sort(order.begin(), order.end(),
+                     [&](size_t x, size_t y) { return avg[x] > avg[y]; });
+    for (size_t i : order) {
+      ranked.push_back(pool[i]);
+      ranked_ai.push_back(from_ai[i]);
+    }
+  }
+  const size_t shown = std::min<size_t>(
+      ranked.size(), tab_show_ > 0 ? tab_show_ : predict_beams_ + 1);
+  ranked.resize(shown);
+  ranked_ai.resize(shown);
+  if (Env("KOTORI_LM_TIME") != nullptr) {
+    std::fprintf(
+        stderr, "[predict] %.0fms pool=%zu shown=%zu cache=%d\n",
+        std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - t0)
+            .count(),
+        pool.size(), shown, from_cache ? 1 : 0);
+  }
+  if (shown == 0) return false;
+  InsertPredictions(&seg, reading, ranked, ranked_ai);
+  return true;
+}
+
+void LmRewriter::StorePredictions(const std::string& reading,
+                                  const std::string& context,
+                                  const std::vector<Prediction>& preds) const {
+  std::lock_guard<std::mutex> lock(job_mu_);
+  for (auto it = cache_.begin(); it != cache_.end(); ++it) {
+    if (it->reading == reading && it->context == context) {
+      cache_.erase(it);
+      break;
+    }
+  }
+  cache_.push_back({reading, context, preds});
+  while (cache_.size() > 32) cache_.pop_front();
+}
+
+std::vector<LmRewriter::Prediction> LmRewriter::CachedPredictions(
+    const std::string& reading, const std::string& context, size_t max) const {
+  std::vector<Entry> entries;
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    entries.assign(cache_.begin(), cache_.end());
+  }
+  std::stable_sort(entries.begin(), entries.end(),
+                   [](const Entry& x, const Entry& y) {
+                     return x.reading.size() > y.reading.size();
+                   });
+  std::vector<Prediction> out;
+  for (const Entry& e : entries) {
+    if (e.context != context || !absl::StartsWith(reading, e.reading)) continue;
+    for (const Prediction& p : e.preds) {
+      if (out.size() >= max) break;
+      const bool dup = std::any_of(out.begin(), out.end(), [&](const Prediction& q) {
+        return q.text == p.text;
+      });
+      if (!dup && PredictionFits(p, reading)) out.push_back(p);
+    }
+    if (out.size() >= max) break;
+  }
+  return out;
+}
+
+bool LmRewriter::RewriteSuggestion(const ConversionRequest& request,
+                                   Segments* segments) const {
+  if (segments->conversion_segments_size() != 1) return false;
+  const config::Config& config = request.config();
+  // AI を切ったとき・シークレットモードでは、覚えておいた予測を捨て、新しく作らない(案 04)。
+  if (!config.kotori_lm_enabled() || request.incognito_mode()) {
+    ClearPredictions();
+    return false;
+  }
+  Segment& seg = *segments->mutable_conversion_segment(0);
+  const std::string reading(seg.key());
+  const std::vector<std::string> rchars = Chars(reading);
+  // 打ちかけのローマ字(「おせわn」)が残っているときは使わない。
+  if (rchars.size() < 2 || rchars.back().size() == 1) return false;
+  const std::string context = HistoryContext(request, *segments);
+  // LLM の予測を使わない(GPU がない、など)ときは、今の読みの変換を裏で先に済ませておく
+  // (先回りの変換。Space で待たせないため。docs/adr/0024)。
+  if (!(predict_ && config.kotori_lm_predict() && UsesLlm(config))) {
+    ClearPredictions();
+    if (preconvert_ && rchars.size() <= kMaxGenerateChars &&
+        (HasGpu() || rchars.size() <= kMaxCpuChars)) {
+      std::lock_guard<std::mutex> lock(job_mu_);
+      job_ = Job{reading, context, config, true};
+      new_job_ = true;
+      job_cv_.notify_one();
+    } else {
+      new_job_ = true;  // 前の読みの先回りの変換をやめる
+    }
+    return false;
+  }
+  // 1. 計算済みの予測のうち、今の読みに合うものを出す(読みの長いものから)。
+  const std::string key = CacheKey(config, context);
+  std::vector<std::string> texts;
+  for (const Prediction& p : CachedPredictions(reading, key, suggest_count_)) {
+    texts.push_back(p.text);
+  }
+  // 2. 今の読みの予測を裏で計算させる(待たない)。長い読みは計算しない。
+  if (rchars.size() <= kMaxPredictChars) {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    bool cached = false;
+    for (const Entry& e : cache_) {
+      cached = cached || (e.reading == reading && e.context == key);
+    }
+    if (!cached) {
+      job_ = Job{reading, context, config};
+      new_job_ = true;
+      job_cv_.notify_one();
+    }
+  }
+  if (Env("KOTORI_LM_STATS") != nullptr) {
+    std::fprintf(stderr, "[stats] %s\n", ZenzScorer::Stats().c_str());
+  }
+  if (Env("KOTORI_LM_DEBUG") != nullptr) {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    std::fprintf(stderr, "[suggest] %s cache=%zu shown=%zu\n", reading.c_str(),
+                 cache_.size(), texts.size());
+  }
+  if (texts.empty()) return false;
+  InsertPredictions(&seg, reading, texts, std::vector<bool>(texts.size(), true));
+  return true;
+}
+
+void LmRewriter::RunPreconvert(const Job& job) {
+  // 続けて打っている間は計算しない(CPU では 1 回の生成が打鍵の間隔より長い)。
+  {
+    std::unique_lock<std::mutex> lock(job_mu_);
+    if (job_cv_.wait_for(lock, std::chrono::milliseconds(preconvert_delay_ms_),
+                         [&] { return stop_ || job_.has_value(); })) {
+      return;
+    }
+  }
+  const std::string key = job.reading + "\t" + job.context;
+  // 要求(変換・Tab)の最中と、終わってから 150 ms はロックを取らない(続けて来る要求を待たせない)。
+  auto now_us = [] {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  };
+  while (urgent_.load() > 0 || now_us() - last_request_us_.load() < 150000) {
+    if (stop_.load() || new_job_.load()) return;
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    if (last_converted_key_ == key) return;  // もう変換した読み
+    running_convert_ = key;
+  }
+  // 新しい打鍵・停止、または別の読みの変換の要求が来たらやめる(同じ読みの変換なら続ける)。
+  auto cancelled = [&] {
+    if (stop_.load() || new_job_.load()) return true;
+    if (urgent_.load() == 0) return false;
+    std::lock_guard<std::mutex> lock(job_mu_);
+    return urgent_key_ != key;
+  };
+  {
+    absl::MutexLock lock(mutex_);
+    size_t k = 0, llm_top = 0;
+    int beams = 0;
+    ZenzScorer* llm = nullptr;
+    ZenzScorer* scorer = PrepareFor(job.config, &k, &llm, &beams, &llm_top,
+                                    false, true, Util::CharsLen(job.reading));
+    if (scorer != nullptr && beams > 0 &&
+        !(gen_cache_ && gen_cache_->key == key && gen_cache_->beams == beams &&
+          gen_cache_->model == ModelKey(scorer))) {
+      std::vector<std::string> texts;
+      {
+        CancelScope cancel(cancelled);
+        texts = scorer->Generate(job.context, job.reading, beams);
+      }
+      if (!cancelled()) gen_cache_ = Generated{key, beams, ModelKey(scorer), texts};
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    running_convert_.clear();
+  }
+}
+
+void LmRewriter::WorkerLoop() {
+  // 最後に受けた設定(入力がないときにモデルを外し、状態を書くのに使う)。
+  std::optional<config::Config> last_config;
+  while (true) {
+    Job job;
+    {
+      std::unique_lock<std::mutex> lock(job_mu_);
+      const auto ready = [&] {
+        return stop_ || job_.has_value() || load_job_.has_value();
+      };
+      // 仕事がなければ 30 秒ごとに、しばらく入力がないかを見てモデルを外す(docs/adr/0034)。
+      while (!job_cv_.wait_for(lock, std::chrono::seconds(30), ready)) {
+        if (!last_config) continue;
+        lock.unlock();
+        UnloadIfIdle(*last_config);
+        lock.lock();
+      }
+      if (stop_) return;
+      if (load_job_) {
+        // モデルの読み込み。読み込み中の変換は待たずに AI なしで出す(TryLockForRequest)。
+        const config::Config config = std::move(*load_job_);
+        load_job_.reset();
+        last_config = config;
+        sleeping_ = false;
+        lock.unlock();
+        loading_ = true;
+        {
+          absl::MutexLock model_lock(mutex_);
+          WriteStatus(config, "loading");
+          size_t k = 0, llm_top = 0;
+          int beams = 0;
+          ZenzScorer* llm = nullptr;
+          PrepareFor(config, &k, &llm, &beams, &llm_top, false, true);
+          // GPU のない PC では、長い読みに使う zenz も読み込んでおく(docs/adr/0035)。
+          PrepareFor(config, &k, &llm, &beams, &llm_top, false, true, SIZE_MAX);
+          // 入力中の AI 予測を使うなら、予測の LLM も読み込んでおく。
+          if (predict_ && config.kotori_lm_predict()) {
+            PrepareFor(config, &k, &llm, &beams, &llm_top, true, true);
+          }
+          WriteStatus(config, "ready");
+        }
+        loading_ = false;
+        continue;
+      }
+      job = std::move(*job_);
+      job_.reset();
+      new_job_ = false;
+    }
+    last_config = job.config;
+    if (job.convert) {
+      RunPreconvert(job);
+      continue;
+    }
+    // 途中でやめたか(変換の要求・停止、重い計算は次の打鍵も)。やめたときは結果を残さない。
+    auto interrupted = [&](bool light) {
+      return urgent_.load() > 0 || stop_.load() || (!light && new_job_.load());
+    };
+    // 1. 軽い計算(次の打鍵に間に合わせる)。2. 手が止まっていれば、Tab と同じ重さで
+    //    作り直す(Tab を押したときに、待たずに良い予測を出せる)。
+    // ms の間に次の打鍵(新しい仕事)が来なければ true。来たら false(その仕事から始め直す)。
+    auto quiet_for = [&](int ms) {
+      if (ms <= 0) return !new_job_.load() && !stop_.load();
+      std::unique_lock<std::mutex> lock(job_mu_);
+      return !job_cv_.wait_for(lock, std::chrono::milliseconds(ms),
+                               [&] { return stop_ || job_.has_value(); });
+    };
+    for (const bool light : {true, false}) {
+      // 続けて打っている間は計算しない(打鍵ごとの計算の多くは次の打鍵で要らなくなる)。
+      // 作り直しは、手が止まってから(docs/adr/0024)。
+      const int delay = light ? light_delay_ms_ : full_delay_ms_;
+      if (delay < 0 || !quiet_for(delay)) break;
+      std::vector<Prediction> preds;
+      {
+        absl::MutexLock lock(mutex_);
+        preds = ComputePredictions(job.config, job.reading, job.context, nullptr,
+                                   true, light);
+      }
+      if (Env("KOTORI_LM_DEBUG") != nullptr) {
+        std::fprintf(stderr, "[worker%s] %s -> %zu preds%s%s%s\n",
+                     light ? "" : " full", job.reading.c_str(), preds.size(),
+                     preds.empty() ? "" : " first=",
+                     preds.empty() ? "" : preds[0].text.c_str(),
+                     interrupted(light) ? " (interrupted)" : "");
+      }
+      if (interrupted(light)) break;
+      StorePredictions(job.reading, CacheKey(job.config, job.context), preds);
+    }
+  }
+}
+
+bool LmRewriter::Rewrite(const ConversionRequest& request,
+                         Segments* segments) const {
+  Touch(request.config());
+  if (request.request_type() == ConversionRequest::SUGGESTION) {
+    return RewriteSuggestion(request, segments);
+  }
+  // サジェストのための変換(1 打鍵ごと)では、AI の変換を動かさない(入力が重くなるため)。
+  if (request.options().skip_slow_rewriters) return false;
+  // LLM がないときの Tab、GPU がなく長い読みでは AI を使わないので、ロックを待たない。
+  if (request.request_type() == ConversionRequest::PREDICTION &&
+      !(predict_ && request.config().kotori_lm_predict() &&
+        UsesLlm(request.config()))) {
+    return false;
+  }
+  if (!HasGpu() && Util::CharsLen(ConversionReading(*segments)) > kMaxCpuChars) {
+    return false;
+  }
+  Urgent urgent(urgent_, last_request_us_);
+  if (!TryLockForRequest(300)) return false;
+  HeldLock lock(mutex_);
+  if (request.request_type() == ConversionRequest::PREDICTION) {
+    return RewritePrediction(request, segments);
+  }
+  size_t k = 0;
+  int beams = 0;
+  ZenzScorer* llm = nullptr;
+  ZenzScorer* scorer = Prepare(request, &k, &llm, &beams);
+  if (scorer == nullptr) return false;
+  // 文全体で選んだ文が今の区切りに合えば、それを先頭に置く。
+  bool changed = false;
+  const bool matched =
+      sentence_ &&
+      ApplyBest(segments, HistoryContext(request, *segments), &changed);
+  if (matched && !post_segment_) return changed;
+  // 文節が多いと、文節ごとの採点(文節ごとに 1 回)で数秒かかる。文全体の選択だけにする。
+  if (segments->conversion_segments_size() > kMaxSegmentsToRescore) return changed;
+  // GPU がなければ文節ごとの採点(文節ごとに 1 回、右の文脈を含む)はしない。CPU では時間の上限に
+  // 収まらないため(docs/adr/0029)。
+  if (!HasGpu()) return changed;
+  // 文節ごとにも見直す。文全体で選んだときは(LLM も見て決めたので)先頭は変えず、
+  // 2 番目以降の候補だけを並べる。時間の上限を超えたら残りの文節はそのまま。
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::milliseconds(BudgetMs());
+  return RewriteEachSegment(request, scorer, k, matched, deadline, segments) ||
+         changed;
+}
