+# llama.cpp(MIT)の CPU 版。x86-64 の AVX2 を前提にする(Kotori は 64 ビットの Windows だけ)。
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+licenses(["notice"])
+
+exports_files(["LICENSE"])
+
+# CMake が作るバージョンのヘッダー。
+write_file(
+    name = "llama_version_h",
+    out = "src/llama-version.h",
+    content = [
+        "#pragma once",
+        "#define LLAMA_VERSION \"kotori\"",
+        "#define LLAMA_COMMIT \"7fe450e\"",
+        "",
+    ],
+)
+
+write_file(
+    name = "ggml_version_h",
+    out = "ggml/src/ggml-version.h",
+    content = [
+        "#pragma once",
+        "#define GGML_VERSION \"kotori\"",
+        "#define GGML_COMMIT \"7fe450e\"",
+        "",
+    ],
+)
+
+_DEFINES = [
+    "GGML_USE_CPU",
+    "GGML_SCHED_MAX_COPIES=4",
+    "_GNU_SOURCE",
+    "_XOPEN_SOURCE=600",
+    "_CRT_SECURE_NO_WARNINGS",
+]
+
+_COPTS = select({
+    "@platforms//os:windows": [
+        "-mavx2",
+        "-mfma",
+        "-mf16c",
+        "-Wno-everything",
+    ],
+    "//conditions:default": [
+        "-mavx2",
+        "-mfma",
+        "-mf16c",
+        "-w",
+    ],
+})
+
+cc_library(
+    name = "ggml",
+    srcs = glob([
+        "ggml/src/*.c",
+        "ggml/src/*.cpp",
+        "ggml/src/*.h",
+        "ggml/src/ggml-cpu/*.c",
+        "ggml/src/ggml-cpu/*.cpp",
+        "ggml/src/ggml-cpu/*.h",
+        "ggml/src/ggml-cpu/amx/*.cpp",
+        "ggml/src/ggml-cpu/amx/*.h",
+        "ggml/src/ggml-cpu/llamafile/*.cpp",
+        "ggml/src/ggml-cpu/llamafile/*.h",
+        "ggml/src/ggml-cpu/arch/x86/*.c",
+        "ggml/src/ggml-cpu/arch/x86/*.cpp",
+    ]) + [":ggml_version_h"],
+    hdrs = glob(["ggml/include/*.h"]),
+    copts = _COPTS,
+    defines = _DEFINES,
+    includes = [
+        "ggml/include",
+        "ggml/src",
+        "ggml/src/ggml-cpu",
+    ],
+    linkopts = select({
+        "@platforms//os:windows": [],
+        "//conditions:default": [
+            "-lpthread",
+            "-lm",
+            "-ldl",
+        ],
+    }),
+)
+
+cc_library(
+    name = "llama",
+    srcs = glob([
+        "src/*.cpp",
+        "src/*.h",
+        "src/models/*.cpp",
+        "src/models/*.h",
+    ]) + [":llama_version_h"],
+    hdrs = glob(["include/*.h"]),
+    copts = select({
+        "@platforms//os:windows": ["-Wno-everything"],
+        "//conditions:default": ["-w"],
+    }),
+    includes = [
+        "include",
+        "src",
+    ],
+    deps = [":ggml"],
+)
