diff --git a/src/bazel/BUILD.llama_cpp.bazel b/src/bazel/BUILD.llama_cpp.bazel
new file mode 100644
index 000000000..cbd6e6dc7
--- /dev/null
+++ b/src/bazel/BUILD.llama_cpp.bazel
@@ -0,0 +1,118 @@
+# llama.cpp(MIT)。Kotori の LM リランク用(docs/adr/0013、0016)。
+#
+# Windows: ヘッダーだけを使い、実行時にインストール先の公式ビルド(llama.dll、ggml*.dll。
+#          GPU は Vulkan)を読み込む(rewriter/llama_runtime.cc)。
+# それ以外(Linux での評価): CPU 版を静的にリンクする。x86-64 の AVX2 を前提にする。
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+licenses(["notice"])
+
+exports_files(["LICENSE"])
+
+# CMake が作るバージョンのヘッダー。
+write_file(
+    name = "llama_version_h",
+    out = "src/llama-version.h",
+    content = [
+        "#pragma once",
+        "#define LLAMA_VERSION \"kotori\"",
+        "#define LLAMA_COMMIT \"b11259\"",
+        "",
+    ],
+)
+
+write_file(
+    name = "ggml_version_h",
+    out = "ggml/src/ggml-version.h",
+    content = [
+        "#pragma once",
+        "#define GGML_VERSION \"kotori\"",
+        "#define GGML_COMMIT \"b11259\"",
+        "",
+    ],
+)
+
+cc_library(
+    name = "headers",
+    hdrs = glob([
+        "include/*.h",
+        "ggml/include/*.h",
+    ]),
+    includes = [
+        "ggml/include",
+        "include",
+    ],
+)
+
+cc_library(
+    name = "ggml_static",
+    srcs = glob([
+        "ggml/src/*.c",
+        "ggml/src/*.cpp",
+        "ggml/src/*.h",
+        "ggml/src/ggml-cpu/*.c",
+        "ggml/src/ggml-cpu/*.cpp",
+        "ggml/src/ggml-cpu/*.h",
+        "ggml/src/ggml-cpu/tiled/*.cpp",
+        "ggml/src/ggml-cpu/tiled/*.h",
+        "ggml/src/ggml-cpu/amx/*.cpp",
+        "ggml/src/ggml-cpu/amx/*.h",
+        "ggml/src/ggml-cpu/llamafile/*.cpp",
+        "ggml/src/ggml-cpu/llamafile/*.h",
+        "ggml/src/ggml-cpu/arch/x86/*.c",
+        "ggml/src/ggml-cpu/arch/x86/*.cpp",
+    ]) + [":ggml_version_h"],
+    copts = [
+        "-mavx2",
+        "-mfma",
+        "-mf16c",
+        "-w",
+    ],
+    defines = [
+        "GGML_USE_CPU",
+        "GGML_SCHED_MAX_COPIES=4",
+        "_GNU_SOURCE",
+        "_XOPEN_SOURCE=600",
+    ],
+    includes = [
+        "ggml/src",
+        "ggml/src/ggml-cpu",
+    ],
+    linkopts = [
+        "-lpthread",
+        "-lm",
+        "-ldl",
+    ],
+    textual_hdrs = glob(
+        ["ggml/src/**/*.inc"],
+        allow_empty = True,
+    ),
+    deps = [":headers"],
+)
+
+cc_library(
+    name = "llama_static",
+    srcs = glob([
+        "src/*.cpp",
+        "src/*.h",
+        "src/models/*.cpp",
+        "src/models/*.h",
+    ]) + [":llama_version_h"],
+    copts = ["-w"],
+    includes = ["src"],
+    deps = [
+        ":ggml_static",
+        ":headers",
+    ],
+)
+
+alias(
+    name = "llama",
+    actual = select({
+        "@platforms//os:windows": ":headers",
+        "//conditions:default": ":llama_static",
+    }),
+)
