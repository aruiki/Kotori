     : pool_(32),
       revert_id_(x.revert_id_),
       max_history_segments_size_(x.max_history_segments_size_),
-      resized_(x.resized_) {
+      resized_(x.resized_),
+      kotori_sentences_(x.kotori_sentences_) {
   // Deep-copy segments.
   for (const Segment* segment : x.segments_) {
     *add_segment() = *segment;
@@ -283,6 +284,7 @@ Segments& Segments::operator=(const Segments& x) {
 
   max_history_segments_size_ = x.max_history_segments_size_;
   resized_ = x.resized_;
+  kotori_sentences_ = x.kotori_sentences_;
   // Deep-copy segments.
   for (const Segment* segment : x.segments_) {
     *add_segment() = *segment;
@@ -429,6 +431,7 @@ void Segments::InitForCommit(absl::string_view key, absl::string_view value) {
 
 void Segments::Clear() {
   clear_segments();
+  kotori_sentences_.clear();
   revert_id_ = 0;
 }
 
