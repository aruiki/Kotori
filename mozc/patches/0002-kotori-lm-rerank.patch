+
+using Units = std::vector<std::pair<std::string, std::string>>;
+
+TEST(LmRewriterSplitTest, SplitsBeforeContentAfterHiragana) {
+  const Units units = {{"明日", "あした"}, {"の", "の"},     {"会議", "かいぎ"},
+                       {"は", "は"},       {"10", "じゅう"}, {"時", "じ"},
+                       {"から", "から"},   {"です", "です"}};
+  std::vector<std::string> keys, values;
+  kotori_internal::SplitIntoSegments(units, 8, &keys, &values);
+  EXPECT_EQ(keys, (std::vector<std::string>{"あしたの", "かいぎは",
+                                            "じゅうじからです"}));
+  EXPECT_EQ(values, (std::vector<std::string>{"明日の", "会議は", "10時からです"}));
+}
+
+TEST(LmRewriterSplitTest, KeepsConsecutiveContentTogether) {
+  // 漢字の後に漢字が続くとき(ひらがなで終わっていない)は区切らない。
+  const Units units = {{"東京", "とうきょう"}, {"特許", "とっきょ"}, {"が", "が"}};
+  std::vector<std::string> keys, values;
+  kotori_internal::SplitIntoSegments(units, 8, &keys, &values);
+  EXPECT_EQ(values, (std::vector<std::string>{"東京特許が"}));
+  EXPECT_EQ(keys, (std::vector<std::string>{"とうきょうとっきょが"}));
+}
+
+TEST(LmRewriterSplitTest, JoinsOverflowIntoLastSegment) {
+  const Units units = {{"本", "ほん"}, {"を", "を"}, {"机", "つくえ"},
+                       {"に", "に"},   {"彼", "かれ"}, {"が", "が"}};
+  std::vector<std::string> keys, values;
+  kotori_internal::SplitIntoSegments(units, 2, &keys, &values);
+  EXPECT_EQ(values, (std::vector<std::string>{"本を", "机に彼が"}));
+  EXPECT_EQ(keys, (std::vector<std::string>{"ほんを", "つくえにかれが"}));
+}
+
+TEST(LmRewriterSplitTest, EmptyUnits) {
+  std::vector<std::string> keys, values;
+  kotori_internal::SplitIntoSegments({}, 8, &keys, &values);
+  EXPECT_TRUE(keys.empty());
+  EXPECT_TRUE(values.empty());
+}
