+// 変換を待たせないための目印。変換の要求が来ている間、裏の予測は途中でやめる。
+class Urgent {
+ public:
+  Urgent(std::atomic<int>& n, std::atomic<int64_t>& last) : n_(n), last_(last) {
+    ++n_;
+  }
+  ~Urgent() {
+    last_ = std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now().time_since_epoch())
+                .count();
+    --n_;
+  }
+
+ private:
+  std::atomic<int>& n_;
+  std::atomic<int64_t>& last_;
+};
