+#ifndef MOZC_REWRITER_ZENZ_SCORER_H_
+#define MOZC_REWRITER_ZENZ_SCORER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+
+struct llama_model;
+struct llama_context;
+
+namespace mozc {
+
+class ZenzScorer {
+ public:
+  // GGUF を読み込む。失敗したら nullptr。
+  static std::unique_ptr<ZenzScorer> Open(const std::string& path, int threads);
+  ~ZenzScorer();
+
+  // 候補ごとの log P(候補 </s> | 読みと左文脈)。失敗したら nullopt。
+  std::optional<std::vector<float>> Score(
+      absl::string_view left_context, absl::string_view reading,
+      const std::vector<std::string>& candidates);
+
+  // zenz のプロンプト。U+EE00 読み(カタカナ) U+EE02 左文脈 U+EE01。
+  static std::string Prompt(absl::string_view left_context,
+                            absl::string_view reading);
+
+ private:
+  ZenzScorer() = default;
+  llama_model* model_ = nullptr;
+  llama_context* ctx_ = nullptr;
+  int max_seq_ = 0;
+};
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_ZENZ_SCORER_H_
