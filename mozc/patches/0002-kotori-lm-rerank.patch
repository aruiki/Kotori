+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+//
+// Kotori: zenz-v2.5 による変換候補の並べ替え(docs/adr/0013、0015)。
+
+#ifndef MOZC_REWRITER_LM_REWRITER_H_
+#define MOZC_REWRITER_LM_REWRITER_H_
+
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "absl/base/thread_annotations.h"
+#include "absl/synchronization/mutex.h"
+#include "converter/segments.h"
+#include "request/conversion_request.h"
+#include "rewriter/rewriter_interface.h"
+#include "rewriter/zenz_scorer.h"
+
+namespace mozc {
+
+// 2 段で並べ替える。
+//
+// 1. 文全体: ImmutableConverter が Segments::kotori_sentences() に入れた文全体の
+//    候補(区切りの違う文を含む)を zenz で採点し、最良の文の区切りで文節を切り直す
+//    (CheckResizeSegmentsRequest)。切り直した後の Rewrite で、各文節の先頭に
+//    最良の文の値を置く。
+// 2. 文節ごと: 文全体の結果が使えないとき、上位 K 件を前後の文節とともに採点する。
+//
+// モデルがなければ何もしない。モデルは、設定のパス → KOTORI_ZENZ_MODEL → 品質の段階の
+// モデル(mozc_server と同じフォルダ)→ 同梱の zenz-v2.5-small-q8_0.gguf の順に探す。
+//
+// 環境変数(評価と調整用):
+//   KOTORI_ZENZ_MODEL  GGUF のパス(設定のパスが空のとき)
+//   KOTORI_LM_K        文節ごとに並べ替える候補の数(品質の段階より優先。0 で無効)
+//   KOTORI_LM_SENTENCE 0 で文全体の並べ替えを切る
+//   KOTORI_LM_WEIGHTS  "λ_lm,λ_lattice,T"(既定 "1,1,1000")
+//   KOTORI_LM_THREADS  推論のスレッド数(既定 4)
+//   KOTORI_LM_PRECEDING 左の文脈を差し替える(評価用)
+class LmRewriter : public RewriterInterface {
+ public:
+  LmRewriter();
+
+  int capability(const ConversionRequest& request) const override {
+    return CONVERSION;
+  }
+
+  std::optional<ResizeSegmentsRequest> CheckResizeSegmentsRequest(
+      const ConversionRequest& request,
+      const Segments& segments) const override;
+
+  bool Rewrite(const ConversionRequest& request,
+               Segments* segments) const override;
+
+ private:
+  struct Best {
+    std::string reading;
+    std::string context;
+    std::vector<std::string> keys;
+    std::vector<std::string> values;
+  };
+
+  // 設定に合わせてモデルを用意する。使えなければ nullptr。*k は文節ごとの候補数。
+  ZenzScorer* Prepare(const ConversionRequest& request, size_t* k) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  void EnsureLoaded(const std::string& path) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  bool ApplyBest(Segments* segments, const std::string& context) const
+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(mutex_);
+  bool RewriteEachSegment(const ConversionRequest& request,
+                          ZenzScorer* scorer, size_t k,
+                          Segments* segments) const;
+  double Combine(float logp, int cost) const {
+    return lambda_lm_ * logp - lambda_lattice_ * cost / temperature_;
+  }
+
+  mutable absl::Mutex mutex_;
+  mutable std::string loaded_path_ ABSL_GUARDED_BY(mutex_);
+  mutable bool loaded_ ABSL_GUARDED_BY(mutex_) = false;
+  mutable std::unique_ptr<ZenzScorer> scorer_ ABSL_GUARDED_BY(mutex_);
+  mutable std::optional<Best> best_ ABSL_GUARDED_BY(mutex_);
+  std::optional<size_t> k_override_;
+  bool sentence_ = true;
+  bool right_context_ = true;
+  double lambda_lm_ = 1.0;
+  double lambda_lattice_ = 1.0;
+  double temperature_ = 1000.0;
+  int threads_ = 4;
+  std::string env_model_path_;
+  std::string model_dir_;
+};
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_LM_REWRITER_H_
