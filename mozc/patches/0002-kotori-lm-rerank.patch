+LmRewriter::~LmRewriter() {
+  {
+    std::lock_guard<std::mutex> lock(job_mu_);
+    stop_ = true;
+  }
+  job_cv_.notify_all();
+  if (worker_.joinable()) worker_.join();
+}
+
+void LmRewriter::EnsureLoaded(const std::string& path) const {
+  if (loaded_ && loaded_path_ == path) return;
+  loaded_ = true;
+  loaded_path_ = path;
+  scorer_.reset();
+  if (!FileUtil::FileExists(path).ok()) return;
+  scorer_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+void LmRewriter::EnsureLlmLoaded(const std::string& path) const {
+  if (llm_loaded_ && llm_path_ == path) return;
+  llm_loaded_ = true;
+  llm_path_ = path;
+  llm_.reset();
+  if (path.empty() || !FileUtil::FileExists(path).ok()) return;
+  llm_ = ZenzScorer::Open(path, threads_, runtime_dir_);
+}
+
+ZenzScorer* LmRewriter::Prepare(const ConversionRequest& request, size_t* k,
+                                ZenzScorer** llm, int* beams) const {
+  size_t llm_top = 0;
+  return PrepareFor(request.config(), k, llm, beams, &llm_top, false,
+                    sync_load_);
+}
+
+ZenzScorer* LmRewriter::PrepareFor(const config::Config& config, size_t* k,
+                                   ZenzScorer** llm, int* beams,
+                                   size_t* llm_top, bool for_predict,
+                                   bool may_load, size_t reading_chars) const {
+  *llm = nullptr;
+  if (!config.kotori_lm_enabled()) return nullptr;
+  // GPU のない PC(内蔵 GPU だけの PC を含む)では、品質の設定に関係なく Low にする。LLM は
+  // CPU では遅すぎ、Standard 以上の中身では変換が固まるため(docs/adr/0024)。
+  const bool gpu = HasGpu();
+  const Quality quality =
+      QualityOf(gpu ? config.kotori_lm_quality() : config::Config::KOTORI_LM_LOW);
+  *k = k_override_.value_or(quality.k);
+  *beams = beams_override_.value_or(quality.beams);
+  *llm_top = llm_top_override_.value_or(quality.llm_top);
+  if (*k < 2) return nullptr;
+  // zenz(生成と採点。常に使う): KOTORI_ZENZ_MODEL → 品質の段階の zenz → 同梱の zenz。
+  std::string path = env_model_path_;
+  if (path.empty()) {
+    path = FileUtil::JoinPath(model_dir_, quality.model);
+    if (!FileUtil::FileExists(path).ok()) {
+      path = FileUtil::JoinPath(model_dir_, kDefaultModelName);
+    }
+  }
+  // まだ読み込んでいなければ、裏のスレッドに頼んで今回は AI なしにする(待たない)。
+  if (!may_load && !(loaded_ && loaded_path_ == path)) {
+    RequestLoad(config);
+    return nullptr;
+  }
+  EnsureLoaded(path);
+  // GPU のない PC で長い読みなら、速い zenz を使う(docs/adr/0035)。品質の段階の zenz と同じなら使わない。
+  ZenzScorer* main_scorer = scorer_.get();
+  if (!gpu && cpu_long_chars_ > 0 &&
+      reading_chars > static_cast<size_t>(cpu_long_chars_)) {
+    const std::string long_path =
+        env_long_path_.empty() ? FileUtil::JoinPath(model_dir_, kDefaultModelName)
+                               : env_long_path_;
+    if (long_path != path) {
+      if (!(long_loaded_ && long_path_ == long_path)) {
+        if (!may_load) {
+          RequestLoad(config);
+        } else {
+          long_loaded_ = true;
+          long_path_ = long_path;
+          long_scorer_.reset();
+          if (FileUtil::FileExists(long_path).ok()) {
+            long_scorer_ = ZenzScorer::Open(long_path, threads_, runtime_dir_);
+          }
+        }
+      }
+      if (long_scorer_ != nullptr) main_scorer = long_scorer_.get();
+    }
+  }
+  // 2 つ目の zenz(Unreal、または評価用の KOTORI_ZENZ_EXTRA_MODEL)。ファイルがなければ使わない。
+  {
+    std::string extra = env_extra_path_;
+    if (extra.empty() && quality.extra != nullptr) {
+      extra = FileUtil::JoinPath(model_dir_, quality.extra);
+    }
+    if (!(extra_loaded_ && extra_path_ == extra)) {
+      if (!may_load && !extra.empty()) {
+        RequestLoad(config);
+      } else {
+        extra_loaded_ = true;
+        extra_path_ = extra;
+        extra_.reset();
+        if (!extra.empty() && FileUtil::FileExists(extra).ok()) {
+          extra_ = ZenzScorer::Open(extra, threads_, runtime_dir_);
+        }
+      }
+    }
+  }
+  // LLM(文全体の採点に加える): AI モデルが LLM か、自動で GPU があるとき(docs/adr/0016)。
+  // ファイルは設定のパス → KOTORI_LLM_MODEL → 同梱の LLM。
+  // 変換で LLM を使うのは llm_top が 1 以上のとき(品質 Standard 以上)。Tab の予測(for_predict)
+  // では品質に関係なく使う。品質 Low では最初の Tab で読み込み、その後は読み込んだままにする。
+  if (!UsesLlm(config)) {
+    EnsureLlmLoaded(std::string());  // 使わない設定なら VRAM を空ける
+    return main_scorer;
+  }
+  if (*llm_top > 0 || for_predict) {
+    std::string llm_path = config.kotori_lm_model_path();
+    if (llm_path.empty()) llm_path = env_llm_path_;
+    if (llm_path.empty()) llm_path = FileUtil::JoinPath(model_dir_, kLlmModelName);
+    if (!may_load && !(llm_loaded_ && llm_path_ == llm_path)) {
+      RequestLoad(config);
+      return main_scorer;
+    }
+    EnsureLlmLoaded(llm_path);
+    *llm = llm_.get();
+  }
+  return main_scorer;
+}
+
+std::string LmRewriter::ModelKey(const ZenzScorer* scorer) const {
+  const std::string& path =
+      scorer != nullptr && scorer == long_scorer_.get() ? long_path_ : loaded_path_;
+  return path + "|" + extra_path_;
+}
+
+std::string LmRewriter::CacheKey(const config::Config& config,
+                                 const std::string& context) const {
+  // 予測の結果を変える設定(品質、AI モデル、LLM のファイル)。違う設定で作った予測は使わない
+  // (docs/IMPROVEMENT_PROPOSALS.md の案 04)。
+  return absl::StrCat(static_cast<int>(config.kotori_lm_quality()), ",",
+                      static_cast<int>(config.kotori_lm_model()), ",",
+                      config.kotori_lm_model_path(), "\x1f", context);
+}
