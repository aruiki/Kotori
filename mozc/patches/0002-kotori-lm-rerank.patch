diff --git a/src/rewriter/lm_rewriter.cc b/src/rewriter/lm_rewriter.cc
new file mode 100755
index 000000000..8df16f484
--- /dev/null
+++ b/src/rewriter/lm_rewriter.cc
@@ -0,0 +1,308 @@
+// Copyright 2026, Kotori IME contributors (BSD-3-Clause, same as Mozc)
+
+#include "rewriter/lm_rewriter.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <numeric>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/synchronization/mutex.h"
+#include "base/file_util.h"
+#include "base/system_util.h"
+#include "base/util.h"
+#include "converter/candidate.h"
+#include "converter/segments.h"
+#include "protocol/config.pb.h"
+#include "request/conversion_request.h"
+
+namespace mozc {
+namespace {
+
+constexpr char kDefaultModelName[] = "zenz-v2.5-small-q8_0.gguf";
+constexpr size_t kMaxContextBytes = 240;  // 40 文字ぶん以上
+constexpr size_t kMaxSentences = 16;
+
+struct Quality {
+  size_t k;
+  const char* model;
+};
+
+Quality QualityOf(config::Config::KotoriLmQuality q) {
+  switch (q) {
+    case config::Config::KOTORI_LM_LOW:
+      return {4, "zenz-v2.5-xsmall-q8_0.gguf"};
+    case config::Config::KOTORI_LM_HIGH:
+      return {16, kDefaultModelName};
+    case config::Config::KOTORI_LM_UNREAL:
+      return {16, "zenz-v2.5-medium-q8_0.gguf"};
+    default:
+      return {8, kDefaultModelName};
+  }
+}
+
+const char* Env(const char* name) {
+  const char* v = std::getenv(name);
+  return (v != nullptr && *v != '\0') ? v : nullptr;
+}
+
+std::string Tail(const std::string& s) {
+  return s.size() > kMaxContextBytes ? s.substr(s.size() - kMaxContextBytes)
+                                     : s;
+}
+
+// 左の文脈。アプリが渡す直前の文(TSF の preceding_text)があればそれを使い、
+// なければ確定済みの文節(履歴)の値をつなぐ。KOTORI_LM_PRECEDING は評価用。
+std::string HistoryContext(const ConversionRequest& request,
+                           const Segments& segments) {
+  if (const char* v = Env("KOTORI_LM_PRECEDING")) return Tail(v);
+  std::string preceding = request.GetSurroundingContext().first;
+  if (!preceding.empty()) return Tail(preceding);
+  std::string context;
+  for (const Segment& seg : segments.history_segments()) {
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return Tail(context);
+}
+
+std::string ConversionReading(const Segments& segments) {
+  std::string reading;
+  for (const Segment& seg : segments.conversion_segments()) {
+    reading += seg.key();
+  }
+  return reading;
+}
+
+}  // namespace
+
+LmRewriter::LmRewriter() {
+  if (const char* v = Env("KOTORI_LM_K")) {
+    k_override_ = std::strtoul(v, nullptr, 10);
+  }
+  if (const char* v = Env("KOTORI_LM_SENTENCE")) sentence_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_RIGHT")) right_context_ = *v != '0';
+  if (const char* v = Env("KOTORI_LM_THREADS")) {
+    threads_ = std::max(1, std::atoi(v));
+  }
+  if (const char* v = Env("KOTORI_LM_WEIGHTS")) {
+    double a, b, t;
+    if (std::sscanf(v, "%lf,%lf,%lf", &a, &b, &t) == 3 && t > 0) {
+      lambda_lm_ = a;
+      lambda_lattice_ = b;
+      temperature_ = t;
+    }
+  }
+  if (const char* v = Env("KOTORI_ZENZ_MODEL")) env_model_path_ = v;
+  model_dir_ = SystemUtil::GetServerDirectory();
+}
+
+void LmRewriter::EnsureLoaded(const std::string& path) const {
+  if (loaded_ && loaded_path_ == path) return;
+  loaded_ = true;
+  loaded_path_ = path;
+  scorer_.reset();
+  if (!FileUtil::FileExists(path).ok()) return;
+  scorer_ = ZenzScorer::Open(path, threads_);
+}
+
+ZenzScorer* LmRewriter::Prepare(const ConversionRequest& request,
+                                size_t* k) const {
+  const config::Config& config = request.config();
+  if (!config.kotori_lm_enabled()) return nullptr;
+  const Quality quality = QualityOf(config.kotori_lm_quality());
+  *k = k_override_.value_or(quality.k);
+  if (*k < 2) return nullptr;
+  std::string path = config.kotori_lm_model_path();
+  if (path.empty()) path = env_model_path_;
+  if (path.empty()) {
+    path = FileUtil::JoinPath(model_dir_, quality.model);
+    if (!FileUtil::FileExists(path).ok()) {
+      path = FileUtil::JoinPath(model_dir_, kDefaultModelName);
+    }
+  }
+  EnsureLoaded(path);
+  return scorer_.get();
+}
+
+std::optional<RewriterInterface::ResizeSegmentsRequest>
+LmRewriter::CheckResizeSegmentsRequest(const ConversionRequest& request,
+                                       const Segments& segments) const {
+  if (!sentence_) return std::nullopt;
+  const std::vector<converter::Candidate>& sentences =
+      segments.kotori_sentences();
+  if (sentences.size() < 2) return std::nullopt;
+  absl::MutexLock lock(mutex_);
+  best_.reset();
+  size_t k = 0;
+  ZenzScorer* scorer = Prepare(request, &k);
+  if (scorer == nullptr) return std::nullopt;
+
+  const std::string reading = ConversionReading(segments);
+  const std::string context = HistoryContext(request, segments);
+  std::vector<const converter::Candidate*> cands;
+  std::vector<std::string> values;
+  for (const converter::Candidate& c : sentences) {
+    if (c.key != reading || c.inner_segment_boundary.empty()) continue;
+    if (std::find(values.begin(), values.end(), c.value) != values.end()) {
+      continue;
+    }
+    cands.push_back(&c);
+    values.push_back(c.value);
+    if (cands.size() >= kMaxSentences) break;
+  }
+  if (cands.size() < 2) return std::nullopt;
+  const std::optional<std::vector<float>> logp =
+      scorer->Score(context, reading, values);
+  if (!logp) return std::nullopt;
+  size_t top = 0;
+  double top_score = 0;
+  for (size_t i = 0; i < cands.size(); ++i) {
+    const double s = Combine((*logp)[i], cands[i]->cost);
+    if (i == 0 || s > top_score) {
+      top = i;
+      top_score = s;
+    }
+  }
+
+  Best best{reading, context, {}, {}};
+  for (const auto& inner : cands[top]->inner_segments()) {
+    best.keys.emplace_back(inner.GetKey());
+    best.values.emplace_back(inner.GetValue());
+  }
+  if (best.keys.empty()) return std::nullopt;
+
+  // 今の区切りと同じなら、切り直さずに Rewrite で先頭を入れ替える。
+  std::vector<std::string> current;
+  for (const Segment& seg : segments.conversion_segments()) {
+    current.emplace_back(seg.key());
+  }
+  best_ = best;
+  if (current == best.keys) return std::nullopt;
+
+  ResizeSegmentsRequest resize;
+  resize.segment_index = 0;
+  const size_t n = std::min(best.keys.size(), resize.segment_sizes.size());
+  for (size_t i = 0; i < n; ++i) {
+    const size_t len = Util::CharsLen(best.keys[i]);
+    if (len == 0 || len > 255) {
+      best_.reset();
+      return std::nullopt;
+    }
+    resize.segment_sizes[i] = static_cast<uint8_t>(len);
+  }
+  return resize;
+}
+
+bool LmRewriter::ApplyBest(Segments* segments,
+                           const std::string& context) const {
+  if (!best_ || best_->context != context ||
+      best_->reading != ConversionReading(*segments)) {
+    return false;
+  }
+  size_t i = 0;
+  for (const Segment& seg : segments->conversion_segments()) {
+    if (i >= best_->keys.size() || seg.key() != best_->keys[i]) return false;
+    ++i;
+  }
+  if (i != best_->keys.size()) return false;
+
+  bool changed = false;
+  i = 0;
+  for (Segment& seg : segments->conversion_segments()) {
+    const std::string& value = best_->values[i++];
+    if (seg.candidates_size() == 0 || seg.candidate(0).value == value) {
+      continue;
+    }
+    int found = -1;
+    for (size_t j = 1; j < seg.candidates_size(); ++j) {
+      if (seg.candidate(j).value == value) {
+        found = static_cast<int>(j);
+        break;
+      }
+    }
+    converter::Candidate c = seg.candidate(found >= 0 ? found : 0);
+    if (found >= 0) {
+      seg.erase_candidate(found);
+    } else {
+      // 文節の候補にない値(文全体の候補でだけ出たもの)は、先頭の候補を写して作る。
+      c.value = value;
+      c.content_value = value;
+      c.content_key = std::string(seg.key());
+      c.inner_segment_boundary.clear();
+    }
+    *seg.insert_candidate(0) = std::move(c);
+    changed = true;
+  }
+  return changed;
+}
+
+bool LmRewriter::RewriteEachSegment(const ConversionRequest& request,
+                                    ZenzScorer* scorer, size_t k,
+                                    Segments* segments) const {
+  std::string context = HistoryContext(request, *segments);
+  bool changed = false;
+  const size_t num_segments = segments->conversion_segments_size();
+  for (size_t s = 0; s < num_segments; ++s) {
+    Segment& seg = *segments->mutable_conversion_segment(s);
+    const size_t n = std::min(seg.candidates_size(), k);
+    if (n >= 2 && !seg.key().empty()) {
+      // 読みと候補の後ろに、残りの文節の読みと第 1 候補をつなぐ。「はが」だけでは
+      // 葉/歯を決められないが、「はがいたい」なら決められる。
+      std::string reading(seg.key());
+      std::string suffix;
+      if (right_context_) {
+        for (size_t t = s + 1; t < num_segments; ++t) {
+          const Segment& next = segments->conversion_segment(t);
+          if (next.candidates_size() == 0) break;
+          reading += next.key();
+          suffix += next.candidate(0).value;
+        }
+      }
+      std::vector<std::string> values;
+      values.reserve(n);
+      for (size_t i = 0; i < n; ++i) {
+        values.push_back(seg.candidate(i).value + suffix);
+      }
+      if (auto logp = scorer->Score(Tail(context), reading, values)) {
+        std::vector<double> score(n);
+        for (size_t i = 0; i < n; ++i) {
+          score[i] = Combine((*logp)[i], seg.candidate(i).cost);
+        }
+        std::vector<size_t> order(n);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+          return score[a] > score[b];
+        });
+        std::vector<converter::Candidate> copies;
+        copies.reserve(n);
+        for (size_t i = 0; i < n; ++i) copies.push_back(seg.candidate(order[i]));
+        for (size_t i = 0; i < n; ++i) {
+          *seg.mutable_candidate(i) = std::move(copies[i]);
+        }
+        changed = changed || order[0] != 0;
+      }
+    }
+    if (seg.candidates_size() > 0) context += seg.candidate(0).value;
+  }
+  return changed;
+}
+
+bool LmRewriter::Rewrite(const ConversionRequest& request,
+                         Segments* segments) const {
+  absl::MutexLock lock(mutex_);
+  size_t k = 0;
+  ZenzScorer* scorer = Prepare(request, &k);
+  if (scorer == nullptr) return false;
+  // 文全体で選んだ文が今の区切りに合えば、それを使う。
+  if (sentence_ && ApplyBest(segments, HistoryContext(request, *segments))) {
+    return true;
+  }
+  return RewriteEachSegment(request, scorer, k, segments);
+}
+
+}  // namespace mozc
